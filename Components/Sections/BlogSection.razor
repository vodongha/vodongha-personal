<section class="section blog" id="blog">
    <div class="section__header">
        <span class="section__label">@Lang.T("blog.label")</span>
        <h2 class="section__title">@Lang.T("blog.title")</h2>
        <p class="section__subtitle">@Lang.T("blog.subtitle")</p>
    </div>

    @if (_posts is null)
    {
        <div class="blog-skel">
            @for (int i = 0; i < 3; i++)
            {
                <div class="blog-skel__card">
                    <div class="blog-skel__img"></div>
                    <div class="blog-skel__body">
                        <div class="blog-skel__tags">
                            <div class="blog-skel__tag"></div>
                            <div class="blog-skel__tag"></div>
                        </div>
                        <div class="blog-skel__title"></div>
                        <div class="blog-skel__title2"></div>
                        <div class="blog-skel__desc"></div>
                        <div class="blog-skel__desc2"></div>
                        <div class="blog-skel__meta"></div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        @if (_posts.Count == 0)
        {
            <p style="text-align:center;color:#6b7280">@Lang.T("blog.empty")</p>
        }
        else
        {
            <div class="blog__grid">
                @foreach (BlogPost post in VisiblePosts)
                {
                    <BlogCard Item="post" OnClick="@(() => Nav.NavigateTo("/blog/" + post.Slug))" />
                }
            </div>

            @if (_posts.Count > InitialCount)
            {
                <div class="section__expand">
                    <button class="section__expand-btn" @onclick="Toggle">
                        @if (_expanded)
                        {
                            <i class="bi bi-chevron-up"></i> @Lang.T("common.showless")
                        }
                        else
                        {
                            <i class="bi bi-chevron-down"></i> @Lang.T("common.showmore")
                        }
                    </button>
                </div>
            }
        }
    }
</section>
