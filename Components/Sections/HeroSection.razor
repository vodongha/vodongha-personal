<section class="hero" id="home">
    <div class="hero__bg">
        <div class="hero__bg-blob hero__bg-blob--1"></div>
        <div class="hero__bg-blob hero__bg-blob--2"></div>
    </div>

    <div class="hero__content">
        <div class="hero__text">
            <span class="hero__badge">&#x1F44B; Xin chào, tôi là</span>

            <h1 class="hero__name">
                Võ Đông Hà<br />
                <span>Full-Stack Developer</span>
            </h1>

            <p class="hero__role">Building modern web experiences</p>

            <p class="hero__desc">
                Tôi xây dựng các ứng dụng web hiện đại với .NET, Blazor và PostgreSQL.
                Đam mê tạo ra những sản phẩm sạch, hiệu quả và đẹp mắt.
            </p>

            <div class="hero__actions">
                <a href="#projects" class="hero__btn-primary">
                    <i class="bi bi-folder2-open"></i>
                    Xem dự án
                </a>
                <a href="#contact" class="hero__btn-outline">
                    <i class="bi bi-send"></i>
                    Liên hệ
                </a>
            </div>

            <div class="hero__social">
                <a href="https://github.com/vodongha" target="_blank" class="hero__social-link" title="GitHub">
                    <i class="bi bi-github"></i>
                </a>
                <a href="https://linkedin.com/in/vodongha" target="_blank" class="hero__social-link" title="LinkedIn">
                    <i class="bi bi-linkedin"></i>
                </a>
                <a href="mailto:REDACTED_EMAIL" class="hero__social-link" title="Email">
                    <i class="bi bi-envelope"></i>
                </a>
            </div>
        </div>

        <div class="hero__avatar">
            <div class="hero__avatar-wrap">
                <img src="/images/avatar.jpg" alt="Võ Đông Hà" class="hero__avatar-img"
                     style="display:none"
                     onload="this.style.display='block'"
                     onerror="this.nextElementSibling.style.display='flex'" />
                <div class="hero__avatar-placeholder">
                    <i class="bi bi-person-circle"></i>
                </div>
                <div class="hero__avatar-ring"></div>
            </div>
        </div>
    </div>

    <div class="hero__scroll">
        <span>Scroll</span>
        <i class="bi bi-chevron-down"></i>
    </div>
</section>
