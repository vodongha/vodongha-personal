<section class="hero" id="home">
    <div class="hero__bg">
        <div class="hero__bg-blob hero__bg-blob--1"></div>
        <div class="hero__bg-blob hero__bg-blob--2"></div>
    </div>

    @if (!_loaded)
    {
        <div class="hero__content">
            <div class="hero-skel">
                <div class="hero-skel__text">
                    <div class="hero-skel__badge"></div>
                    <div class="hero-skel__name"></div>
                    <div class="hero-skel__name-2"></div>
                    <div class="hero-skel__role"></div>
                    <div class="hero-skel__desc"></div>
                    <div class="hero-skel__actions">
                        <div class="hero-skel__btn"></div>
                        <div class="hero-skel__btn"></div>
                    </div>
                    <div class="hero-skel__social">
                        <div class="hero-skel__icon"></div>
                        <div class="hero-skel__icon"></div>
                        <div class="hero-skel__icon"></div>
                    </div>
                </div>
                <div class="hero-skel__avatar"></div>
            </div>
        </div>
    }
    else
    {
    <div class="hero__content">
        <div class="hero__text">
            <span class="hero__badge">@Lang.T("hero.greeting")</span>

            <h1 class="hero__name">
                @S("Name") <br />
                <span>@S("Title")</span>
            </h1>

            <p class="hero__role">@Lang.T("hero.role")</p>

            <p class="hero__desc">@Bio</p>

            <div class="hero__actions">
                <a href="#projects" class="hero__btn-primary">
                    <i class="bi bi-folder2-open"></i>
                    @Lang.T("hero.cta.view")
                </a>
                <a href="#contact" class="hero__btn-outline">
                    <i class="bi bi-send"></i>
                    @Lang.T("hero.cta.contact")
                </a>
            </div>

            <div class="hero__social">
                @if (!string.IsNullOrEmpty(S("GitHub")))
                {
                    <a href="@S("GitHub")" target="_blank" class="hero__social-link" title="GitHub">
                        <i class="bi bi-github"></i>
                    </a>
                }
                @if (!string.IsNullOrEmpty(S("LinkedIn")))
                {
                    <a href="@S("LinkedIn")" target="_blank" class="hero__social-link" title="LinkedIn">
                        <i class="bi bi-linkedin"></i>
                    </a>
                }
                @if (!string.IsNullOrEmpty(S("Facebook")))
                {
                    <a href="@S("Facebook")" target="_blank" class="hero__social-link" title="Facebook">
                        <i class="bi bi-facebook"></i>
                    </a>
                }
                @if (!string.IsNullOrEmpty(S("Email")))
                {
                    <a href="mailto:@S("Email")" class="hero__social-link" title="Email">
                        <i class="bi bi-envelope"></i>
                    </a>
                }
            </div>
        </div>

        <div class="hero__avatar">
            <div class="hero__avatar-outer">
                <div class="hero__avatar-ring2"></div>
                <div class="hero__avatar-wrap">
                    <img src="@(S("AvatarUrl") is { Length: > 0 } av ? av : "/images/avatar.png")" alt="@S("Name")" class="hero__avatar-img"
                         style="display:none"
                         onload="this.style.display='block'"
                         onerror="this.nextElementSibling.style.display='flex'" />
                    <div class="hero__avatar-placeholder"></div>
                </div>
            </div>
        </div>
    </div>
    } @* end else (_loaded) *@

    <button class="hero__scroll" onclick="document.getElementById('skills').scrollIntoView({behavior:'smooth'})">
        <span>Scroll</span>
        <i class="bi bi-chevron-down"></i>
    </button>
</section>
