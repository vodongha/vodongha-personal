@inject ContactService ContactSvc
@inject LanguageService Lang
@implements IDisposable

<section class="section contact" id="contact">
    <div class="section__header">
        <span class="section__label">@Lang.T("contact.label")</span>
        <h2 class="section__title">@Lang.T("contact.title")</h2>
        <p class="section__subtitle">@Lang.T("contact.subtitle")</p>
    </div>

    <div class="contact__inner">
        <div class="contact__info">
            <div class="contact__info-item">
                <div class="contact__info-icon"><i class="bi bi-geo-alt"></i></div>
                <div>
                    <div class="contact__info-label">@(Lang.IsVi ? "Äá»‹a chá»‰" : "Location")</div>
                    <div class="contact__info-value">Ho Chi Minh City, Vietnam</div>
                </div>
            </div>
            <div class="contact__info-item">
                <div class="contact__info-icon"><i class="bi bi-envelope"></i></div>
                <div>
                    <div class="contact__info-label">Email</div>
                    <div class="contact__info-value">vodongha@hotmail.com</div>
                </div>
            </div>
            <div class="contact__info-item">
                <div class="contact__info-icon"><i class="bi bi-github"></i></div>
                <div>
                    <div class="contact__info-label">GitHub</div>
                    <div class="contact__info-value">github.com/vodongha</div>
                </div>
            </div>
        </div>

        @if (_sent)
        {
            <div class="contact__form contact__success">
                <i class="bi bi-check-circle"></i>
                <h3>@Lang.T("contact.success")</h3>
            </div>
        }
        else
        {
            <EditForm Model="_model" OnValidSubmit="HandleSubmit" class="contact__form">
                <DataAnnotationsValidator />

                <div class="contact__field">
                    <label class="contact__label">@Lang.T("contact.name")</label>
                    <InputText @bind-Value="_model.Name" class="contact__input" />
                    <ValidationMessage For="() => _model.Name" />
                </div>

                <div class="contact__field">
                    <label class="contact__label">@Lang.T("contact.email")</label>
                    <InputText @bind-Value="_model.Email" class="contact__input" />
                    <ValidationMessage For="() => _model.Email" />
                </div>

                <div class="contact__field">
                    <label class="contact__label">@(Lang.IsVi ? "TiÃªu Ä‘á»" : "Subject")</label>
                    <InputText @bind-Value="_model.Subject" class="contact__input" />
                    <ValidationMessage For="() => _model.Subject" />
                </div>

                <div class="contact__field">
                    <label class="contact__label">@Lang.T("contact.message")</label>
                    <InputTextArea @bind-Value="_model.Message" class="contact__textarea" />
                    <ValidationMessage For="() => _model.Message" />
                </div>

                <button type="submit" class="contact__submit" disabled="@_sending">
                    @if (_sending)
                    {
                        <span>@(Lang.IsVi ? "Äang gá»­i..." : "Sending...")</span>
                    }
                    else
                    {
                        <i class="bi bi-send"></i>
                        <span>@Lang.T("contact.send")</span>
                    }
                </button>
            </EditForm>
        }
    </div>
</section>

@code {
    private ContactMessage _model = new();
    private bool _sending;
    private bool _sent;

    protected override void OnInitialized() => Lang.OnChange += StateHasChanged;
    public void Dispose() => Lang.OnChange -= StateHasChanged;

    private async Task HandleSubmit()
    {
        _sending = true;
        await ContactSvc.SendAsync(_model);
        _sent = true;
        _sending = false;
    }
}
