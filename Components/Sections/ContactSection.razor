@rendermode InteractiveServer
@inject ContactService ContactSvc

<section class="section contact" id="contact">
    <div class="section__header">
        <span class="section__label">Liên hệ</span>
        <h2 class="section__title">Kết nối với tôi</h2>
        <p class="section__subtitle">Hãy nhắn cho tôi nếu bạn muốn hợp tác hoặc chỉ muốn nói chuyện</p>
    </div>

    <div class="contact__inner">
        <div class="contact__info">
            <div class="contact__info-item">
                <div class="contact__info-icon">
                    <i class="bi bi-geo-alt"></i>
                </div>
                <div>
                    <div class="contact__info-label">Địa chỉ</div>
                    <div class="contact__info-value">Việt Nam</div>
                </div>
            </div>

            <div class="contact__info-item">
                <div class="contact__info-icon">
                    <i class="bi bi-envelope"></i>
                </div>
                <div>
                    <div class="contact__info-label">Email</div>
                    <div class="contact__info-value">ha.vodong@cisbox.com</div>
                </div>
            </div>

            <div class="contact__info-item">
                <div class="contact__info-icon">
                    <i class="bi bi-github"></i>
                </div>
                <div>
                    <div class="contact__info-label">GitHub</div>
                    <div class="contact__info-value">github.com/vodongha</div>
                </div>
            </div>
        </div>

        @if (_sent)
        {
            <div class="contact__form contact__success">
                <i class="bi bi-check-circle"></i>
                <h3>Đã gửi thành công!</h3>
                <p>Cảm ơn bạn đã liên hệ. Tôi sẽ phản hồi sớm nhất có thể.</p>
            </div>
        }
        else
        {
            <EditForm Model="_model" OnValidSubmit="HandleSubmit" class="contact__form">
                <DataAnnotationsValidator />

                <div class="contact__field">
                    <label class="contact__label">Họ tên</label>
                    <InputText @bind-Value="_model.Name" class="contact__input" placeholder="Nguyễn Văn A" />
                    <ValidationMessage For="() => _model.Name" />
                </div>

                <div class="contact__field">
                    <label class="contact__label">Email</label>
                    <InputText @bind-Value="_model.Email" class="contact__input" placeholder="email@example.com" />
                    <ValidationMessage For="() => _model.Email" />
                </div>

                <div class="contact__field">
                    <label class="contact__label">Tiêu đề</label>
                    <InputText @bind-Value="_model.Subject" class="contact__input" placeholder="Muốn hợp tác dự án..." />
                    <ValidationMessage For="() => _model.Subject" />
                </div>

                <div class="contact__field">
                    <label class="contact__label">Nội dung</label>
                    <InputTextArea @bind-Value="_model.Message" class="contact__textarea" placeholder="Nội dung tin nhắn..." />
                    <ValidationMessage For="() => _model.Message" />
                </div>

                <button type="submit" class="contact__submit" disabled="@_sending">
                    @if (_sending)
                    {
                        <span>Đang gửi...</span>
                    }
                    else
                    {
                        <i class="bi bi-send"></i>
                        <span>Gửi tin nhắn</span>
                    }
                </button>
            </EditForm>
        }
    </div>
</section>

@code {
    private ContactMessage _model = new();
    private bool _sending;
    private bool _sent;

    private async Task HandleSubmit()
    {
        _sending = true;
        await ContactSvc.SendAsync(_model);
        _sent = true;
        _sending = false;
    }
}
