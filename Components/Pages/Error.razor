@page "/Error"
@using System.Diagnostics
@layout MainLayout
@inject LanguageService Lang
@implements IDisposable

<PageTitle>500 — @(Lang.IsVi ? "Lỗi máy chủ" : "Server Error")</PageTitle>

<div class="server-error">
    <div class="server-error__glow"></div>

    <div class="server-error__code">
        <span class="server-error__digit">5</span>
        <span class="server-error__zero">
            <span class="server-error__zero-inner">0</span>
        </span>
        <span class="server-error__zero">
            <span class="server-error__zero-inner">0</span>
        </span>
    </div>

    <h1 class="server-error__title">
        @(Lang.IsVi ? "Lỗi máy chủ nội bộ" : "Internal Server Error")
    </h1>

    <p class="server-error__desc">
        @if (Lang.IsVi)
        {
            <span>Đã xảy ra lỗi không mong muốn. Vui lòng thử lại sau</span>
            <br />
            <span>hoặc quay về trang chủ.</span>
        }
        else
        {
            <span>Something went wrong on our end. Please try again later</span>
            <br />
            <span>or head back home.</span>
        }
    </p>

    <div class="server-error__actions">
        <a href="/" class="server-error__btn server-error__btn--primary">
            <i class="bi bi-house"></i>
            @(Lang.IsVi ? "Về trang chủ" : "Back to home")
        </a>
        <button class="server-error__btn server-error__btn--ghost" @onclick="Reload">
            <i class="bi bi-arrow-clockwise"></i>
            @(Lang.IsVi ? "Thử lại" : "Try again")
        </button>
    </div>

    @if (ShowRequestId)
    {
        <p class="server-error__hint">
            <span class="server-error__mono">HTTP 500 · @RequestId</span>
        </p>
    }
    else
    {
        <p class="server-error__hint">
            <span class="server-error__mono">HTTP 500</span>
        </p>
    }
</div>

@code {
    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    private string? RequestId { get; set; }
    private bool ShowRequestId => !string.IsNullOrEmpty(RequestId);

    protected override void OnInitialized()
    {
        RequestId = Activity.Current?.Id ?? HttpContext?.TraceIdentifier;
        Lang.OnChange += StateHasChanged;
    }

    public void Dispose() => Lang.OnChange -= StateHasChanged;

    private void Reload() => HttpContext?.Response.Redirect(HttpContext.Request.Path);
}
