@page "/admin/settings"
@layout AdminLayout
@attribute [Authorize]
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Authorization
@using VodonghaPersonal.Data.Models
@inject AdminLocalizationService Loc

<div class="admin-shell">
    <AdminNav />

    <main class="admin-main">
        <header class="admin-header">
            <h1 class="admin-header__title">@Loc.T("Personal information")</h1>
        </header>

        <div class="admin-settings-grid">
            <div class="admin-settings-section">
                <h2 class="admin-settings-section__title">@Loc.T("Introduction")</h2>
                <div class="admin-form__group">
                    <label class="admin-form__label">Avatar</label>
                    <div class="admin-avatar-upload" @onclick="TriggerFilePicker" title="Bấm để đổi ảnh">
                        @if (!string.IsNullOrEmpty(Val["AvatarUrl"]))
                        {
                            <img src="@Val["AvatarUrl"]" alt="Avatar" class="admin-avatar-upload__img" />
                        }
                        else
                        {
                            <div class="admin-avatar-upload__placeholder"><i class="bi bi-person-fill"></i></div>
                        }
                        <div class="admin-avatar-upload__overlay">
                            @if (_uploading)
                            {
                                <span class="admin-avatar-upload__label"><i class="bi bi-arrow-repeat admin-spin"></i></span>
                            }
                            else
                            {
                                <span class="admin-avatar-upload__label"><i class="bi bi-camera"></i> @Loc.T("Change photo")</span>
                            }
                        </div>
                    </div>
                    <InputFile id="avatarFileInput" OnChange="OnAvatarFileChange" accept="image/*" style="display:none" />
                    @if (!string.IsNullOrEmpty(Val["AvatarUrl"]))
                    {
                        <small style="opacity:.4;font-size:0.75rem;margin-top:0.35rem;display:block;word-break:break-all">@Val["AvatarUrl"]</small>
                    }
                </div>
                <div class="admin-form__group">
                    <label class="admin-form__label">@Loc.T("Full name")</label>
                    <input class="admin-form__input" value="@Val["Name"]" @oninput='e => Val["Name"] = e.Value?.ToString() ?? ""' />
                </div>
                <div class="admin-form__group">
                    <label class="admin-form__label">@Loc.T("Job title")</label>
                    <input class="admin-form__input" value="@Val["Title"]" @oninput='e => Val["Title"] = e.Value?.ToString() ?? ""' />
                </div>
                <div class="admin-form__group">
                    <label class="admin-form__label">@Loc.T("Tagline")</label>
                    <input class="admin-form__input" value="@Val["Tagline"]" @oninput='e => Val["Tagline"] = e.Value?.ToString() ?? ""' />
                </div>
                <div class="admin-form__group">
                    <label class="admin-form__label">@Loc.T("Bio VI")</label>
                    <textarea class="admin-form__input admin-form__textarea" @oninput='e => Val["Bio"] = e.Value?.ToString() ?? ""'>@Val["Bio"]</textarea>
                </div>
                <div class="admin-form__group">
                    <label class="admin-form__label">@Loc.T("Bio EN")</label>
                    <textarea class="admin-form__input admin-form__textarea" @oninput='e => Val["BioEn"] = e.Value?.ToString() ?? ""'>@Val["BioEn"]</textarea>
                </div>
            </div>

            <div class="admin-settings-section">
                <h2 class="admin-settings-section__title">@Loc.T("Contact")</h2>
                <div class="admin-form__group">
                    <label class="admin-form__label">Email</label>
                    <input class="admin-form__input" type="email" value="@Val["Email"]" @oninput='e => Val["Email"] = e.Value?.ToString() ?? ""' />
                </div>
                <div class="admin-form__group">
                    <label class="admin-form__label">@Loc.T("Phone")</label>
                    <input class="admin-form__input" value="@Val["Phone"]" @oninput='e => Val["Phone"] = e.Value?.ToString() ?? ""' />
                </div>
                <div class="admin-form__group">
                    <label class="admin-form__label">@Loc.T("Address")</label>
                    <input class="admin-form__input" value="@Val["Location"]" @oninput='e => Val["Location"] = e.Value?.ToString() ?? ""' />
                </div>

                <h2 class="admin-settings-section__title" style="margin-top:1.5rem">@Loc.T("Social media")</h2>
                <div class="admin-form__group">
                    <label class="admin-form__label">@Loc.T("GitHub URL")</label>
                    <input class="admin-form__input" value="@Val["GitHub"]" @oninput='e => Val["GitHub"] = e.Value?.ToString() ?? ""' />
                </div>
                <div class="admin-form__group">
                    <label class="admin-form__label">@Loc.T("LinkedIn URL")</label>
                    <input class="admin-form__input" value="@Val["LinkedIn"]" @oninput='e => Val["LinkedIn"] = e.Value?.ToString() ?? ""' />
                </div>
                <div class="admin-form__group">
                    <label class="admin-form__label">@Loc.T("Facebook URL")</label>
                    <input class="admin-form__input" value="@Val["Facebook"]" @oninput='e => Val["Facebook"] = e.Value?.ToString() ?? ""' placeholder="https://facebook.com/..." />
                </div>
            </div>
        </div>

        <div style="margin-top:2rem">
            <button class="admin-btn admin-btn--primary" @onclick="SaveAll">
                <i class="bi bi-check-lg"></i> @Loc.T("Save all")
            </button>
        </div>
    </main>
</div>


