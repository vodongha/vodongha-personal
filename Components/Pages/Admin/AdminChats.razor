@page "/admin/chats"
@layout AdminLayout
@attribute [Authorize]
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Authorization
@using vodongha.Data.Models

<div class="admin-shell">
    <aside class="admin-sidebar">
        <div class="admin-sidebar__logo"><span>vdh</span><span class="dot">.</span><span>admin</span></div>
        <nav class="admin-nav">
            <a href="/admin" class="admin-nav__item"><i class="bi bi-grid"></i> Dashboard</a>
            <a href="/admin/skills" class="admin-nav__item"><i class="bi bi-bar-chart"></i> Skills</a>
            <a href="/admin/projects" class="admin-nav__item"><i class="bi bi-folder2"></i> Projects</a>
            <a href="/admin/education" class="admin-nav__item"><i class="bi bi-mortarboard"></i> Education</a>
            <a href="/admin/experience" class="admin-nav__item"><i class="bi bi-briefcase"></i> Experience</a>
            <a href="/admin/blog" class="admin-nav__item"><i class="bi bi-file-text"></i> Blog</a>
            <a href="/admin/contacts" class="admin-nav__item"><i class="bi bi-envelope"></i> Messages</a>
            <a href="/admin/chats" class="admin-nav__item admin-nav__item--active"><i class="bi bi-chat-dots"></i> Chats @if (_unreadChatCount > 0) { <span class="admin-badge-count">@_unreadChatCount</span> }</a>
            <a href="/admin/settings" class="admin-nav__item"><i class="bi bi-gear"></i> Thông tin</a>
        </nav>
        <form method="post" action="/admin/logout" class="admin-sidebar__logout">
            <button type="submit" class="admin-nav__item"><i class="bi bi-box-arrow-left"></i> Đăng xuất</button>
        </form>
    </aside>

    <main class="admin-main">
        <header class="admin-header">
            <h1 class="admin-header__title">Live Chats</h1>
        </header>

        @if (_sessions.Count == 0)
        {
            <div class="admin-empty">
                <i class="bi bi-chat-dots" style="font-size:3rem;opacity:.3"></i>
                <p style="margin-top:.75rem;opacity:.5">No chat sessions yet.</p>
            </div>
        }
        else
        {
            <div class="admin-chat-layout @(_selectedSessionId.HasValue ? "admin-chat-layout--chat-open" : "")">
                <div class="chat-sessions">
                    @foreach (ChatSession session in _sessions)
                    {
                        <div class="chat-session-card @(_selectedSessionId == session.Id ? "chat-session-card--active" : "") @(session.HasUnread ? "chat-session-card--unread" : "")"
                             @onclick="() => SelectSession(session.Id)">
                            <div class="chat-session-card__info">
                                <div class="chat-session-card__name">
                                    @if (session.HasUnread) { <span class="admin-unread-dot" title="Chưa đọc"></span> }
                                    @session.Name
                                </div>
                                <div class="chat-session-card__meta">@session.Email · @session.Phone</div>
                            </div>
                            <div class="chat-session-card__time">@session.LastMessageAt.ToLocalTime().ToString("MM/dd HH:mm")</div>
                        </div>
                    }
                </div>

                @if (_selectedSessionId.HasValue)
                {
                    <div class="chat-admin-window">
                        <div class="chat-header" style="flex-shrink:0;border-bottom:1px solid #2a2a2a;padding:.875rem 1rem;background:#141414">
                            <button class="chat-admin-back" @onclick="CloseChat" title="Quay lại">
                                <i class="bi bi-arrow-left"></i>
                            </button>
                            <div class="chat-header__info">
                                <div class="chat-header__avatar"><i class="bi bi-person-circle"></i></div>
                                <div>
                                    <div class="chat-header__name">@_selectedSession?.Name</div>
                                    <div style="font-size:.7rem;color:#6b7280">@_selectedSession?.Email · @_selectedSession?.Phone</div>
                                </div>
                            </div>
                        </div>

                        <div class="chat-admin-messages" id="adminChatMessages">
                            @{
                                @* User messages after admin's last message = unread (admin hasn't replied yet) *@
                                DateTime? lastAdminMsgTime = _messages.Where(m => !m.IsFromUser).Select(m => (DateTime?)m.SentAt).Max();
                                int firstUnreadIdx = _messages.FindIndex(m => m.IsFromUser && (lastAdminMsgTime == null || m.SentAt > lastAdminMsgTime));
                            }
                            @for (int i = 0; i < _messages.Count; i++)
                            {
                                ChatMessage msg = _messages[i];
                                bool isUnread = msg.IsFromUser && (lastAdminMsgTime == null || msg.SentAt > lastAdminMsgTime);

                                @if (i == firstUnreadIdx)
                                {
                                    <div class="chat-unread-divider chat-unread-divider--admin">
                                        <span>Chưa trả lời</span>
                                    </div>
                                }

                                <div class="chat-msg @(msg.IsFromUser ? "chat-msg--admin" : "chat-msg--user") @(isUnread ? "chat-msg--unread" : "")">
                                    <div class="chat-msg__bubble">@msg.Content</div>
                                    <div class="chat-msg__time">
                                        @(msg.IsFromUser ? "User" : "Admin") · @msg.SentAt.ToLocalTime().ToString("HH:mm")
                                    </div>
                                </div>
                            }

                            @if (_messages.Count == 0)
                            {
                                <div style="text-align:center;color:#6b7280;font-size:.8rem;margin-top:1rem">No messages yet.</div>
                            }

                            @if (_otherIsTyping)
                            {
                                <div class="chat-msg chat-msg--user">
                                    <div class="chat-typing">
                                        <span></span><span></span><span></span>
                                    </div>
                                </div>
                            }
                        </div>

                        <div class="chat-admin-input">
                            <textarea rows="2" placeholder="Nhập tin nhắn trả lời..."
                                      value="@_replyText"
                                      @oninput="OnReplyInput"
                                      @onkeydown="OnReplyKeyDown"></textarea>
                            <button class="admin-btn admin-btn--primary"
                                    @onclick="SendReply"
                                    disabled="@(string.IsNullOrWhiteSpace(_replyText) || _sending)">
                                @if (_sending)
                                {
                                    <i class="bi bi-arrow-clockwise admin-spin"></i>
                                }
                                else
                                {
                                    <i class="bi bi-send"></i>
                                }
                                <span>Gửi</span>
                            </button>
                        </div>
                    </div>
                }
                else
                {
                    <div class="admin-chat-placeholder">
                        Chọn một cuộc trò chuyện để xem
                    </div>
                }
            </div>
        }
    </main>
</div>
