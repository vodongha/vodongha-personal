@page "/admin/blog"
@layout AdminLayout
@attribute [Authorize]
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.QuickGrid
@using VodonghaPersonal.Data.Models
@inject AdminLocalizationService Loc

<div class="admin-shell">
    <AdminNav />

    <main class="admin-main">
        <header class="admin-header">
            <h1 class="admin-header__title">@Loc.T("Blog")</h1>
            <button type="button" class="admin-btn admin-btn--primary" @onclick="OpenAdd"><i class="bi bi-plus-lg"></i> @Loc.T("Add new")</button>
        </header>

        <div class="admin-toolbar">
            <div class="admin-select-wrap">
                <select class="admin-page-size" @onchange="SetPageSize">
                    <option value="5">5 / @Loc.T("page")</option>
                    <option value="10" selected>10 / @Loc.T("page")</option>
                    <option value="20">20 / @Loc.T("page")</option>
                    <option value="50">50 / @Loc.T("page")</option>
                </select>
            </div>
            <div class="admin-search-wrap">
                <i class="bi bi-search admin-search-wrap__icon"></i>
                <input class="admin-form__input admin-search" @bind="_search" @bind:event="oninput" placeholder="@Loc.T("Search title, tags...")" />
            </div>
        </div>

        @if (_loading)
        {
            <div class="admin-tbl-skel">
                <div class="admin-tbl-skel__head">
                    <div class="admin-tbl-skel__cell admin-tbl-skel__cell--lg"></div>
                    <div class="admin-tbl-skel__cell admin-tbl-skel__cell--lg"></div>
                    <div class="admin-tbl-skel__cell admin-tbl-skel__cell--md"></div>
                    <div class="admin-tbl-skel__cell admin-tbl-skel__cell--sm"></div>
                    <div class="admin-tbl-skel__cell admin-tbl-skel__cell--md"></div>
                    <div class="admin-tbl-skel__cell admin-tbl-skel__cell--md"></div>
                </div>
                @for (int i = 0; i < 8; i++)
                {
                    <div class="admin-tbl-skel__row">
                        <div class="admin-tbl-skel__cell admin-tbl-skel__cell--lg"></div>
                        <div class="admin-tbl-skel__cell admin-tbl-skel__cell--lg"></div>
                        <div class="admin-tbl-skel__cell admin-tbl-skel__cell--md"></div>
                        <div class="admin-tbl-skel__cell admin-tbl-skel__cell--sm"></div>
                        <div class="admin-tbl-skel__cell admin-tbl-skel__cell--md"></div>
                        <div class="admin-tbl-skel__cell admin-tbl-skel__cell--btn"></div>
                    </div>
                }
            </div>
        }
        else
        {
        <QuickGrid Items="Filtered" Pagination="_pagination" class="quickgrid">
            <PropertyColumn Property="p => p.Title" Title="@Loc.T("Title")" Sortable="true" />
            <PropertyColumn Property="p => p.Slug" Title="@Loc.T("Slug")" Sortable="true" />
            <PropertyColumn Property="p => p.Tags" Title="@Loc.T("Tags")" Sortable="false" />
            <TemplateColumn Title="@Loc.T("Published")" Sortable="false">
                @(context.IsPublished ? "✓" : "")
            </TemplateColumn>
            <PropertyColumn Property="p => p.CreatedAt" Title="@Loc.T("Created date")" Format="yyyy-MM-dd" Sortable="true" />
            <TemplateColumn Title="@Loc.T("Actions")">
                <div class="admin-table__actions">
                    <button class="admin-btn admin-btn--sm admin-btn--ghost" @onclick="() => OpenEdit(context)"><i class="bi bi-pencil"></i></button>
                    <button class="admin-btn admin-btn--sm admin-btn--danger" @onclick="() => ConfirmDelete(context.Id)"><i class="bi bi-trash"></i></button>
                </div>
            </TemplateColumn>
        </QuickGrid>
        <Paginator State="_pagination" />
        }

        @if (ShowForm)
        {
            <div class="admin-modal-overlay" @onclick="CloseForm">
                <div class="admin-modal admin-modal--lg" @onclick:stopPropagation>
                    <h2 class="admin-modal__title">@(Editing.Id == 0 ? Loc.T("Add post") : Loc.T("Edit post"))</h2>
                    <div class="admin-form__group">
                        <label class="admin-form__label">@Loc.T("Title") 🇻🇳</label>
                        <input class="admin-form__input" value="@Editing.Title" @oninput="OnTitleInput" />
                    </div>
                    <div class="admin-form__group">
                        <label class="admin-form__label">@Loc.T("Title EN")</label>
                        <input class="admin-form__input" @bind="Editing.TitleEn" />
                    </div>
                    <div class="admin-form__group">
                        <label class="admin-form__label">Slug</label>
                        <input class="admin-form__input" @bind="Editing.Slug" placeholder="auto-generated-from-title" />
                    </div>
                    <div class="admin-form__group">
                        <label class="admin-form__label">@Loc.T("Summary VI")</label>
                        <textarea class="admin-form__input admin-form__textarea" @bind="Editing.Summary"></textarea>
                    </div>
                    <div class="admin-form__group">
                        <label class="admin-form__label">@Loc.T("Summary EN")</label>
                        <textarea class="admin-form__input admin-form__textarea" @bind="Editing.SummaryEn"></textarea>
                    </div>
                    <div class="admin-form__group">
                        <label class="admin-form__label">@Loc.T("Content VI")</label>
                        <textarea class="admin-form__input admin-form__textarea admin-form__textarea--tall" @bind="Editing.Content"></textarea>
                    </div>
                    <div class="admin-form__group">
                        <label class="admin-form__label">@Loc.T("Content EN")</label>
                        <textarea class="admin-form__input admin-form__textarea admin-form__textarea--tall" @bind="Editing.ContentEn"></textarea>
                    </div>
                    <div class="admin-form__group">
                        <label class="admin-form__label">@Loc.T("Tags (comma separated)")</label>
                        <input class="admin-form__input" @bind="Editing.Tags" placeholder=".NET,Blazor,..." />
                    </div>
                    <div class="admin-form__group">
                        <label class="admin-form__label">@Loc.T("Cover Image URL")</label>
                        <input class="admin-form__input" @bind="Editing.CoverImageUrl" placeholder="https://..." />
                    </div>
                    <div class="admin-form__group admin-form__check">
                        <label><input type="checkbox" @bind="Editing.IsPublished" /> @Loc.T("Published")</label>
                    </div>
                    <div class="admin-modal__footer">
                        <button class="admin-btn admin-btn--ghost" @onclick="CloseForm">@Loc.T("Cancel")</button>
                        <button class="admin-btn admin-btn--primary" @onclick="Save">@Loc.T("Save")</button>
                    </div>
                </div>
            </div>
        }
        <ConfirmDialog Show="_confirmShow" OnConfirm="ExecuteDelete" OnCancel="() => _confirmShow = false" />
    </main>
</div>


