@page "/admin/costs"
@layout AdminLayout
@attribute [Authorize]
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Authorization


<div class="admin-shell">
    <AdminNav />

    <main class="admin-main">
        <header class="admin-header">
            <h1 class="admin-header__title">
                <i class="bi bi-currency-dollar"></i> @Loc.T("Infrastructure Costs")
            </h1>
            <div class="health-refresh">
                <span class="health-refresh__label">@Loc.T("Cache"): 5 @Loc.T("min")</span>
                <button class="admin-btn admin-btn--ghost admin-btn--sm" @onclick="Refresh" disabled="@_loading">
                    <i class="bi bi-arrow-clockwise @(_loading ? "admin-spin" : "")"></i> @Loc.T("Refresh")
                </button>
            </div>
        </header>

        @if (_loading)
        {
            <!-- Skeleton loading — mirrors the real page structure -->
            <div class="cost-skeleton">
                <!-- Summary banner skeleton -->
                <div class="cost-skeleton__banner">
                    <div class="cost-skeleton__banner-cols">
                        <div class="cost-skeleton__banner-col">
                            <div class="skel skel--label"></div>
                            <div class="skel skel--value-lg"></div>
                            <div class="skel skel--sub"></div>
                        </div>
                        <div class="cost-skeleton__banner-divider"></div>
                        <div class="cost-skeleton__banner-col">
                            <div class="skel skel--label"></div>
                            <div class="skel skel--value-lg"></div>
                            <div class="skel skel--sub"></div>
                        </div>
                    </div>
                    <div class="cost-skeleton__banner-footer">
                        <div class="skel skel--badge"></div>
                        <div class="skel skel--sub" style="margin-left:auto"></div>
                    </div>
                </div>

                <!-- Fly.io section skeleton -->
                <div class="cost-skeleton__section">
                    <div class="cost-skeleton__section-header">
                        <div class="skel skel--section-title"></div>
                        <div class="skel skel--btn"></div>
                    </div>
                    <div class="cost-skeleton__cards">
                        @for (int i = 0; i < 6; i++)
                        {
                            <div class="cost-skeleton__card">
                                <div class="skel skel--icon"></div>
                                <div class="cost-skeleton__card-body">
                                    <div class="skel skel--card-label"></div>
                                    <div class="skel skel--card-value"></div>
                                </div>
                            </div>
                        }
                    </div>
                </div>

                <!-- Neon section skeleton -->
                <div class="cost-skeleton__section">
                    <div class="cost-skeleton__section-header">
                        <div class="skel skel--section-title"></div>
                        <div class="skel skel--btn"></div>
                    </div>
                    <div class="cost-skeleton__cards">
                        @for (int i = 0; i < 5; i++)
                        {
                            <div class="cost-skeleton__card">
                                <div class="skel skel--icon"></div>
                                <div class="cost-skeleton__card-body">
                                    <div class="skel skel--card-label"></div>
                                    <div class="skel skel--card-value"></div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>
        }
        else if (_summary == null)
        {
            <div class="cost-empty">
                <i class="bi bi-exclamation-circle"></i>
                @Loc.T("No data. Configure Fly:ApiToken, Neon:ApiKey and Neon:ProjectId in secrets.")
            </div>
        }
        else
        {
            <!-- Summary banner — 2 columns: actual MTD + estimated max -->
            <div class="cost-summary-banner">
                <div class="cost-summary-banner__cols">
                    <!-- Estimated MTD -->
                    <div class="cost-summary-banner__col">
                        <div class="cost-summary-banner__col-label">
                            <i class="bi bi-receipt"></i> @Loc.T("Est. this month")
                        </div>
                        @if (_summary.Fly != null)
                        {
                            <div class="cost-summary-banner__col-value cost-summary-banner__col-value--actual">
                                @(_summary.Fly.EstimatedMtdDollars == 0 ? "FREE" : FormatUsd(_summary.Fly.EstimatedMtdDollars))
                            </div>
                            <div class="cost-summary-banner__col-sub">@Loc.T("Day 1–@day est. (24/7)").Replace("@day", DateTime.UtcNow.Day.ToString())</div>
                        }
                        else
                        {
                            <div class="cost-summary-banner__col-value cost-summary-banner__col-value--na">N/A</div>
                            <div class="cost-summary-banner__col-sub">@Loc.T("No Fly.io data")</div>
                        }
                    </div>

                    <div class="cost-summary-banner__divider"></div>

                    <!-- Estimated max -->
                    <div class="cost-summary-banner__col">
                        <div class="cost-summary-banner__col-label">
                            <i class="bi bi-calculator"></i> @Loc.T("Estimated max / month")
                        </div>
                        <div class="cost-summary-banner__col-value">
                            @FormatUsd(TotalEstimated)
                        </div>
                        <div class="cost-summary-banner__col-sub">@Loc.T("Theoretical 24/7 max")</div>
                    </div>
                </div>

                <div class="cost-summary-banner__footer">
                    @if (TotalEstimated == 0)
                    {
                        <div class="cost-badge cost-badge--free"><i class="bi bi-gift"></i> @Loc.T("Free tier")</div>
                    }
                    <span class="cost-summary-banner__updated">
                        @Loc.T("Updated"): @_summary.FetchedAt.ToString("HH:mm:ss") UTC
                    </span>
                </div>
            </div>

            <!-- Fly.io section -->
            <div class="cost-section">
                <div class="cost-section__header">
                    <span class="cost-section__title">
                        <i class="bi bi-airplane"></i> Fly.io
                    </span>
                    <a href="https://fly.io/dashboard" target="_blank" rel="noopener"
                       class="admin-btn admin-btn--ghost admin-btn--sm">
                        <i class="bi bi-box-arrow-up-right"></i> @Loc.T("Dashboard")
                    </a>
                </div>

                @if (_summary.Fly == null)
                {
                    <div class="cost-empty cost-empty--sm">
                        <i class="bi bi-plug-fill"></i> @Loc.T("Add Fly:ApiToken to secrets to enable")
                    </div>
                }
                else
                {
                    <div id="fly-cards-grid" class="health-cards cost-cards" data-saved-order="@_flyOrder">
                        <div class="health-card health-card--ok" data-card-id="fly-app">
                            <i class="bi bi-grip-vertical cost-card-drag-handle"></i>
                            <div class="health-card__icon"><i class="bi bi-airplane-fill"></i></div>
                            <div class="health-card__body">
                                <div class="health-card__label">App</div>
                                <div class="health-card__value health-card__value--wrap">@_summary.Fly.AppName</div>
                            </div>
                        </div>

                        @foreach (FlyMachine m in _summary.Fly.Machines)
                        {
                            <div class="health-card @MachineCardClass(m.State)" data-card-id="fly-machine-@m.Id">
                                <i class="bi bi-grip-vertical cost-card-drag-handle"></i>
                                <div class="health-card__icon"><i class="bi @MachineIcon(m.State)"></i></div>
                                <div class="health-card__body">
                                    <div class="health-card__label">@m.Size · @m.MemoryMb MB · @m.Region</div>
                                    <div class="health-card__value health-card__value--wrap">@MachinStateLabel(m.State)</div>
                                </div>
                                <div class="health-card__dot health-card__dot--@(m.State == "started" ? "ok" : "warn")"></div>
                            </div>
                        }

                        <div class="health-card" data-card-id="fly-compute">
                            <i class="bi bi-grip-vertical cost-card-drag-handle"></i>
                            <div class="health-card__icon"><i class="bi bi-cpu"></i></div>
                            <div class="health-card__body">
                                <div class="health-card__label">@Loc.T("Compute rate")</div>
                                <div class="health-card__value health-card__value--wrap">@FormatUsd(_summary.Fly.ComputePerHour) / h</div>
                            </div>
                        </div>

                        <div class="health-card" data-card-id="fly-maxcompute">
                            <i class="bi bi-grip-vertical cost-card-drag-handle"></i>
                            <div class="health-card__icon"><i class="bi bi-calculator"></i></div>
                            <div class="health-card__body">
                                <div class="health-card__label">@Loc.T("Max compute / month")</div>
                                <div class="health-card__value health-card__value--wrap">@FormatUsd(_summary.Fly.ComputePerMonth24h)</div>
                                <div class="cost-sub">24/7 × 30d</div>
                            </div>
                        </div>

                        <div class="health-card" data-card-id="fly-ipv4">
                            <i class="bi bi-grip-vertical cost-card-drag-handle"></i>
                            <div class="health-card__icon"><i class="bi bi-diagram-3"></i></div>
                            <div class="health-card__body">
                                <div class="health-card__label">IPv4 @Loc.T("(dedicated)")</div>
                                <div class="health-card__value health-card__value--wrap">@FormatUsd(_summary.Fly.Ipv4PerMonth)</div>
                            </div>
                        </div>

                        <div class="health-card" data-card-id="fly-free">
                            <i class="bi bi-grip-vertical cost-card-drag-handle"></i>
                            <div class="health-card__icon"><i class="bi bi-gift"></i></div>
                            <div class="health-card__body">
                                <div class="health-card__label">@Loc.T("Free allowance")</div>
                                <div class="health-card__value health-card__value--wrap cost-green">−@FormatUsd(_summary.Fly.FreeAllowance)</div>
                            </div>
                        </div>

                        <div class="health-card @(_summary.Fly.EstimatedBillable == 0 ? "health-card--ok" : "")" data-card-id="fly-maxbill">
                            <i class="bi bi-grip-vertical cost-card-drag-handle"></i>
                            <div class="health-card__icon"><i class="bi bi-receipt"></i></div>
                            <div class="health-card__body">
                                <div class="health-card__label">@Loc.T("Est. max billable")</div>
                                <div class="health-card__value health-card__value--wrap @(_summary.Fly.EstimatedBillable == 0 ? "cost-green" : "cost-yellow")">
                                    @(_summary.Fly.EstimatedBillable == 0 ? "FREE" : FormatUsd(_summary.Fly.EstimatedBillable))
                                </div>
                            </div>
                        </div>

                        <div class="health-card @(_summary.Fly.EstimatedMtdDollars == 0 ? "health-card--ok" : "")" data-card-id="fly-mtd">
                            <i class="bi bi-grip-vertical cost-card-drag-handle"></i>
                            <div class="health-card__icon"><i class="bi bi-cash-stack"></i></div>
                            <div class="health-card__body">
                                <div class="health-card__label">@Loc.T("Est. this month")</div>
                                <div class="health-card__value health-card__value--wrap @(_summary.Fly.EstimatedMtdDollars == 0 ? "cost-green" : "cost-blue")">
                                    @(_summary.Fly.EstimatedMtdDollars == 0 ? "FREE" : FormatUsd(_summary.Fly.EstimatedMtdDollars))
                                </div>
                                <div class="cost-sub">@Loc.T("Day 1–") @DateTime.UtcNow.Day @Loc.T("(24/7 est.)")</div>
                            </div>
                        </div>
                    </div>

                    <p class="cost-note">
                        <i class="bi bi-info-circle"></i>
                        @((MarkupString)Loc.T("Estimated max is theoretical (24/7). With <code>auto_stop_machines = &quot;suspend&quot;</code> actual cost is significantly lower."))
                    </p>
                }
            </div>

            <!-- Neon section -->
            <div class="cost-section">
                <div class="cost-section__header">
                    <span class="cost-section__title">
                        <i class="bi bi-database"></i> Neon
                    </span>
                    <a href="https://console.neon.tech" target="_blank" rel="noopener"
                       class="admin-btn admin-btn--ghost admin-btn--sm">
                        <i class="bi bi-box-arrow-up-right"></i> @Loc.T("Console")
                    </a>
                </div>

                @if (_summary.Neon == null)
                {
                    <div class="cost-empty cost-empty--sm">
                        <i class="bi bi-plug-fill"></i> @Loc.T("Add Neon:ApiKey and Neon:ProjectId to secrets to enable")
                    </div>
                }
                else
                {
                    <div id="neon-cards-grid" class="health-cards cost-cards" data-saved-order="@_neonOrder">
                        <div class="health-card health-card--ok" data-card-id="neon-project">
                            <i class="bi bi-grip-vertical cost-card-drag-handle"></i>
                            <div class="health-card__icon"><i class="bi bi-database-fill"></i></div>
                            <div class="health-card__body">
                                <div class="health-card__label">@Loc.T("Project")</div>
                                <div class="health-card__value health-card__value--wrap">@_summary.Neon.Name</div>
                            </div>
                        </div>

                        <div class="health-card @(_summary.Neon.Plan == "free" ? "health-card--ok" : "")" data-card-id="neon-plan">
                            <i class="bi bi-grip-vertical cost-card-drag-handle"></i>
                            <div class="health-card__icon"><i class="bi bi-patch-check"></i></div>
                            <div class="health-card__body">
                                <div class="health-card__label">@Loc.T("Plan")</div>
                                <div class="health-card__value health-card__value--wrap" style="text-transform:capitalize">
                                    @_summary.Neon.Plan
                                    @if (_summary.Neon.Plan == "free")
                                    {
                                        <span class="cost-badge cost-badge--free cost-badge--inline">FREE</span>
                                    }
                                </div>
                            </div>
                        </div>

                        <div class="health-card" data-card-id="neon-region">
                            <i class="bi bi-grip-vertical cost-card-drag-handle"></i>
                            <div class="health-card__icon"><i class="bi bi-geo-alt"></i></div>
                            <div class="health-card__body">
                                <div class="health-card__label">@Loc.T("Region")</div>
                                <div class="health-card__value health-card__value--wrap">@_summary.Neon.Region</div>
                            </div>
                        </div>

                        <div class="health-card" data-card-id="neon-storage">
                            <i class="bi bi-grip-vertical cost-card-drag-handle"></i>
                            <div class="health-card__icon"><i class="bi bi-hdd"></i></div>
                            <div class="health-card__body">
                                <div class="health-card__label">@Loc.T("Storage used")</div>
                                <div class="health-card__value health-card__value--wrap">
                                    @if (_summary.Neon.StorageMb >= 1024)
                                    {
                                        @($"{_summary.Neon.StorageGb:F2} GB")
                                    }
                                    else
                                    {
                                        @($"{_summary.Neon.StorageMb:F1} MB")
                                    }
                                    <span class="cost-sub">/ 512 MB @Loc.T("free")</span>
                                </div>
                            </div>
                        </div>

                        <div class="health-card" data-card-id="neon-pg">
                            <i class="bi bi-grip-vertical cost-card-drag-handle"></i>
                            <div class="health-card__icon"><i class="bi bi-server"></i></div>
                            <div class="health-card__body">
                                <div class="health-card__label">PostgreSQL</div>
                                <div class="health-card__value health-card__value--wrap">v@(_summary.Neon.PgVersion)</div>
                            </div>
                        </div>

                        <div class="health-card cost-card--wide" data-card-id="neon-bar">
                            <i class="bi bi-grip-vertical cost-card-drag-handle"></i>
                            <div class="health-card__body" style="width:100%">
                                <div class="health-card__label">@Loc.T("Storage usage")</div>
                                <div class="cost-progress-wrap">
                                    <div class="cost-progress">
                                        <div class="cost-progress__bar"
                                             style="width:@($"{Math.Min(100, _summary.Neon.StorageMb / 512.0 * 100):F1}")%"></div>
                                    </div>
                                    <span class="cost-progress__pct">@($"{_summary.Neon.StorageMb / 512.0 * 100:F1}")%</span>
                                </div>
                            </div>
                        </div>

                        <div class="health-card @(_summary.Neon.EstimatedMonthlyCost == 0 ? "health-card--ok" : "")" data-card-id="neon-cost">
                            <i class="bi bi-grip-vertical cost-card-drag-handle"></i>
                            <div class="health-card__icon"><i class="bi bi-receipt"></i></div>
                            <div class="health-card__body">
                                <div class="health-card__label">@Loc.T("Est. cost / month")</div>
                                <div class="health-card__value health-card__value--wrap @(_summary.Neon.EstimatedMonthlyCost == 0 ? "cost-green" : "cost-yellow")">
                                    @(_summary.Neon.EstimatedMonthlyCost == 0 ? "FREE" : FormatUsd(_summary.Neon.EstimatedMonthlyCost))
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </main>
</div>
