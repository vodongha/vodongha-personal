@page "/admin"
@layout AdminLayout
@attribute [Authorize]
@using Microsoft.AspNetCore.Authorization

<div class="admin-shell">
    <AdminNav />

    <main class="admin-main">
        <header class="admin-header">
            <h1 class="admin-header__title">Dashboard</h1>
            <a href="/" target="_blank" class="admin-btn admin-btn--ghost"><i class="bi bi-box-arrow-up-right"></i> Xem website</a>
        </header>

        <div class="admin-cards">
            <a href="/admin/skills" class="admin-card">
                <i class="bi bi-bar-chart admin-card__icon"></i>
                <span class="admin-card__label">Skills</span>
            </a>
            <a href="/admin/projects" class="admin-card">
                <i class="bi bi-folder2 admin-card__icon"></i>
                <span class="admin-card__label">Projects</span>
            </a>
            <a href="/admin/education" class="admin-card">
                <i class="bi bi-mortarboard admin-card__icon"></i>
                <span class="admin-card__label">Education</span>
            </a>
            <a href="/admin/experience" class="admin-card">
                <i class="bi bi-briefcase admin-card__icon"></i>
                <span class="admin-card__label">Experience</span>
            </a>
            <a href="/admin/blog" class="admin-card">
                <i class="bi bi-file-text admin-card__icon"></i>
                <span class="admin-card__label">Blog</span>
            </a>
            <a href="/admin/contacts" class="admin-card @(_unreadMessagesCount > 0 ? "admin-card--unread" : "")">
                <div class="admin-card__icon-wrap">
                    <i class="bi bi-envelope admin-card__icon"></i>
                    @if (_unreadMessagesCount > 0)
                    {
                        <span class="admin-card__badge">@(_unreadMessagesCount > 99 ? "99+" : _unreadMessagesCount.ToString())</span>
                    }
                </div>
                <span class="admin-card__label">Messages</span>
            </a>
            <a href="/admin/chats" class="admin-card @(_unreadChatCount > 0 ? "admin-card--unread" : "")">
                <div class="admin-card__icon-wrap">
                    <i class="bi bi-chat-dots admin-card__icon"></i>
                    @if (_unreadChatCount > 0)
                    {
                        <span class="admin-card__badge">@(_unreadChatCount > 99 ? "99+" : _unreadChatCount.ToString())</span>
                    }
                </div>
                <span class="admin-card__label">Chats</span>
            </a>
            <a href="/admin/settings" class="admin-card">
                <i class="bi bi-gear admin-card__icon"></i>
                <span class="admin-card__label">Thông tin</span>
            </a>
        </div>
    </main>
</div>

