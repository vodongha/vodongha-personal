@page "/blog/{Slug}"
@rendermode InteractiveServer
@using vodongha.Components.Shared

<PageTitle>@(DisplayTitle ?? "Blog") — Võ Đông Hà</PageTitle>

@if (_post is not null)
{
    <HeadContent>
        <meta name="description" content="@DisplaySummary" />
        <meta property="og:type" content="article" />
        <meta property="og:title" content="@DisplayTitle — Võ Đông Hà" />
        <meta property="og:description" content="@DisplaySummary" />
        <meta property="og:url" content="https://vodongha.id.vn/blog/@_post.Slug" />
        @if (!string.IsNullOrEmpty(_post.CoverImageUrl))
        {
            <meta property="og:image" content="@_post.CoverImageUrl" />
            <meta name="twitter:image" content="@_post.CoverImageUrl" />
        }
        <meta name="twitter:card" content="summary_large_image" />
        <meta name="twitter:title" content="@DisplayTitle — Võ Đông Hà" />
        <meta name="twitter:description" content="@DisplaySummary" />
        <link rel="canonical" href="https://vodongha.id.vn/blog/@_post.Slug" />
    </HeadContent>
}

@* Reading progress bar — fixed at top, only on blog post pages *@
<div id="reading-progress-bar"></div>

@if (_loading)
{
    <div class="blog-post-skel">
        <div class="blog-post-skel__back"></div>
        <div class="blog-post-skel__title"></div>
        <div class="blog-post-skel__title2"></div>
        <div class="blog-post-skel__meta"></div>
        <div class="blog-post-skel__tags">
            <div class="blog-post-skel__tag"></div>
            <div class="blog-post-skel__tag"></div>
            <div class="blog-post-skel__tag"></div>
        </div>
        <div class="blog-post-skel__img"></div>
        <div class="blog-post-skel__h2"></div>
        <div class="blog-post-skel__p"></div>
        <div class="blog-post-skel__p"></div>
        <div class="blog-post-skel__p--sm"></div>
        <div class="blog-post-skel__h2"></div>
        <div class="blog-post-skel__p"></div>
        <div class="blog-post-skel__p--sm"></div>
    </div>
}
else if (_post is null)
{
    <div class="blog-post">
        <p>Không tìm thấy bài viết.</p>
        <a href="/" class="blog-post__back"><i class="bi bi-arrow-left"></i> Quay lại</a>
    </div>
}
else
{
    <article class="blog-post">
        <a href="/#blog" class="blog-post__back">
            <i class="bi bi-arrow-left"></i>
            @Lang.T("blog.back")
        </a>

        <header class="blog-post__header">
            <h1 class="blog-post__title">@DisplayTitle</h1>
            <div class="blog-post__meta">
                <span><i class="bi bi-calendar3"></i> @Tz.ToUserTime(_post.CreatedAt).ToString("dd/MM/yyyy")</span>
                <span>·</span>
                <span><i class="bi bi-clock"></i> @ReadingMinutes @Lang.T("blog.readtime")</span>
                @if (_post.ViewCount > 0)
                {
                    <span>·</span>
                    <span><i class="bi bi-eye"></i> @_post.ViewCount @Lang.T("blog.views")</span>
                }
                @if (_post.UpdatedAt.HasValue)
                {
                    <span>· @Lang.T("blog.updated") @Tz.ToUserTime(_post.UpdatedAt.Value).ToString("dd/MM/yyyy")</span>
                }
            </div>

            @if (!string.IsNullOrEmpty(_post.Tags))
            {
                <div class="blog-post__tags">
                    @foreach (string tag in _post.Tags.Split(',', StringSplitOptions.RemoveEmptyEntries))
                    {
                        <span class="blog-post__tag">@tag.Trim()</span>
                    }
                </div>
            }
        </header>

        <div class="blog-post__layout">
            <div class="blog-post__main">
                <div class="blog-post__content">
                    @((MarkupString)DisplayContent)
                </div>
                <BlogShareButtons Slug="@_post.Slug" Title="@DisplayTitle" />
                <RelatedPosts PostId="@_post.Id" Tags="@_post.Tags" />
            </div>
            <aside class="blog-post__sidebar">
                <TableOfContents Content="@DisplayContent" />
            </aside>
        </div>
    </article>
}
