@page "/blog/{Slug}"
@rendermode InteractiveServer

<PageTitle>@(DisplayTitle ?? "Blog") — Võ Đông Hà</PageTitle>

@if (_post is not null)
{
    <HeadContent>
        <meta name="description" content="@DisplaySummary" />
        <meta property="og:type" content="article" />
        <meta property="og:title" content="@DisplayTitle — Võ Đông Hà" />
        <meta property="og:description" content="@DisplaySummary" />
        <meta property="og:url" content="https://vodongha.id.vn/blog/@_post.Slug" />
        @if (!string.IsNullOrEmpty(_post.CoverImageUrl))
        {
            <meta property="og:image" content="@_post.CoverImageUrl" />
        }
        <meta name="twitter:card" content="summary_large_image" />
        <meta name="twitter:title" content="@DisplayTitle — Võ Đông Hà" />
        <meta name="twitter:description" content="@DisplaySummary" />
        <link rel="canonical" href="https://vodongha.id.vn/blog/@_post.Slug" />
    </HeadContent>
}

@if (_post is null)
{
    <div class="blog-post">
        <p>Không tìm thấy bài viết.</p>
        <a href="/" class="blog-post__back"><i class="bi bi-arrow-left"></i> Quay lại</a>
    </div>
}
else
{
    <article class="blog-post">
        <a href="/#blog" class="blog-post__back">
            <i class="bi bi-arrow-left"></i>
            Quay lại
        </a>

        <header class="blog-post__header">
            <h1 class="blog-post__title">@DisplayTitle</h1>
            <div class="blog-post__meta">
                <span><i class="bi bi-calendar3"></i> @Tz.ToUserTime(_post.CreatedAt).ToString("dd/MM/yyyy")</span>
                @if (_post.UpdatedAt.HasValue)
                {
                    <span>· Cập nhật @Tz.ToUserTime(_post.UpdatedAt.Value).ToString("dd/MM/yyyy")</span>
                }
            </div>

            @if (!string.IsNullOrEmpty(_post.Tags))
            {
                <div class="blog-post__tags">
                    @foreach (string tag in _post.Tags.Split(',', StringSplitOptions.RemoveEmptyEntries))
                    {
                        <span class="blog-post__tag">@tag.Trim()</span>
                    }
                </div>
            }
        </header>

        <div class="blog-post__content">
            @((MarkupString)DisplayContent)
        </div>
    </article>
}
