@inject IHttpContextAccessor HttpContextAccessor
@{
    HttpContext? ctx = HttpContextAccessor.HttpContext;
    string clientIp = ctx?.Request.Headers["Fly-Client-IP"].FirstOrDefault()
        ?? ctx?.Request.Headers["X-Forwarded-For"].FirstOrDefault()?.Split(',')[0].Trim()
        ?? ctx?.Connection.RemoteIpAddress?.ToString()
        ?? "";
}
<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="color-scheme" content="dark" />
    @* Theme FOUC prevention — must run before CSS renders *@
    <script>(function(){var t=localStorage.getItem('theme')||(window.matchMedia('(prefers-color-scheme:light)').matches?'light':'dark');document.documentElement.setAttribute('data-theme',t);})()</script>
    <meta name="description" content="Võ Đông Hà — Full-Stack Developer specialising in .NET, Blazor and PostgreSQL. Personal site showcasing projects, experience and blog." />
    <meta name="author" content="Võ Đông Hà" />
    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Võ Đông Hà" />
    <meta property="og:title" content="Võ Đông Hà — Full-Stack Developer" />
    <meta property="og:description" content="Full-Stack Developer specialising in .NET, Blazor and PostgreSQL. Explore my projects, experience and blog." />
    <meta property="og:url" content="https://vodongha.id.vn" />
    <meta property="og:image" content="https://vodongha.id.vn/images/avatar.png" />
    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content="Võ Đông Hà — Full-Stack Developer" />
    <meta name="twitter:description" content="Full-Stack Developer specialising in .NET, Blazor and PostgreSQL." />
    <meta name="twitter:image" content="https://vodongha.id.vn/images/avatar.png" />
    <!-- Canonical -->
    <link rel="canonical" href="https://vodongha.id.vn" />
    <base href="/" />
    <ResourcePreloader />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/gh/devicons/devicon@latest/devicon.min.css" />
    <link rel="stylesheet" href="@Assets["app.css"]" />
    <ImportMap />
    <link rel="icon" type="image/png" href="favicon.png" />
    <HeadOutlet />
</head>

<body>
    <div id="nav-loading-bar"><div id="nav-loading-bar__fill"></div></div>
    <Routes />
    <button id="back-to-top" aria-label="Back to top" onclick="window.scrollTo({top:0,behavior:'smooth'})">
        <i class="bi bi-chevron-up"></i>
    </button>
    <ReconnectModal />
    <script>window.getTimezone = () => Intl.DateTimeFormat().resolvedOptions().timeZone;</script>
    <script>window.__clientIp = '@clientIp';</script>
    <script>
        // Increase Blazor circuit reconnect retries to handle Fly.io suspend wakeup (~3-5s)
        window.Blazor = window.Blazor || {};
        window.Blazor._internal = window.Blazor._internal || {};
        Blazor.start = Blazor.start || (() => {});
    </script>
    <script src="@Assets["_framework/blazor.web.js"]" autostart="false"></script>
    <script>
        Blazor.start({
            circuit: {
                reconnectionOptions: {
                    maxRetries: 10,
                    retryIntervalMilliseconds: (previousAttempts) => {
                        // Quick retries at first (handles Fly.io cold start), then slow down
                        if (previousAttempts < 3) return 1000;
                        if (previousAttempts < 6) return 3000;
                        return 6000;
                    }
                }
            }
        });
    </script>
    <script src="js/admin.js"></script>
    <script src="js/chat.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.5.1/dist/chart.umd.min.js"></script>
    <script src="js/healthChart.js"></script>
</body>

</html>
