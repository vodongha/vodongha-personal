@rendermode InteractiveServer

<footer class="footer">
    <div class="footer__inner">
        <p class="footer__copy">
            &copy; @DateTime.Now.Year <span>Võ Đông Hà</span>. @Lang.T("footer.built")
        </p>
        <ul class="footer__links">
            <li><a href="https://github.com/vodongha" target="_blank" class="footer__link">GitHub</a></li>
            <li><a href="mailto:REDACTED_EMAIL" class="footer__link">Email</a></li>
        </ul>
        <span class="footer__visitors" title="@(Lang.IsVi ? "Khách truy cập độc lập" : "Unique visitors")">
            <i class="bi bi-eye"></i>
            @_visitorCount.ToString("N0")
        </span>
    </div>
</footer>
