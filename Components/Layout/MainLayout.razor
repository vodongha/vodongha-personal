@inherits LayoutComponentBase
@inject LanguageService Lang
@implements IDisposable

<NavBar />

<main>
    @Body
</main>

<footer class="footer">
    <div class="footer__inner">
        <p class="footer__copy">
            &copy; @DateTime.Now.Year <span>Võ Đông Hà</span>. @Lang.T("footer.built") Blazor &amp; ❤️
        </p>
        <ul class="footer__links">
            <li><a href="https://github.com/vodongha" target="_blank" class="footer__link">GitHub</a></li>
            <li><a href="mailto:vodongha@hotmail.com" class="footer__link">Email</a></li>
        </ul>
    </div>
</footer>

<div id="blazor-error-ui" data-nosnippet>
    Có lỗi xảy ra.
    <a href="." class="reload">Tải lại</a>
    <span class="dismiss">&#x2715;</span>
</div>

@code {
    protected override void OnInitialized() => Lang.OnChange += StateHasChanged;
    public void Dispose() => Lang.OnChange -= StateHasChanged;
}
