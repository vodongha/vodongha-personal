@rendermode InteractiveServer

@if (_state != ChatState.Closed)
{
    <div class="chat-panel">
        <div class="chat-header">
            <div class="chat-header__info">
                <div class="chat-header__avatar"><i class="bi bi-person-circle"></i></div>
                <div>
                    <div class="chat-header__name">Võ Đông Hà</div>
                    <div class="chat-header__status">● Online</div>
                </div>
            </div>
            <button class="chat-header__close" @onclick="Close" title="Đóng">
                <i class="bi bi-x-lg"></i>
            </button>
        </div>

        @if (_state == ChatState.Form)
        {
            <div class="chat-form">
                <div class="chat-form__title">Bắt đầu cuộc trò chuyện</div>
                <div class="chat-form__subtitle">Điền thông tin để mình có thể liên hệ lại với bạn.</div>

                <div class="chat-form__group">
                    <label class="chat-form__label">Họ tên *</label>
                    <input class="chat-form__input" type="text" placeholder="Nguyễn Văn A"
                           @bind="_name" @bind:event="oninput" />
                </div>
                <div class="chat-form__group">
                    <label class="chat-form__label">Số điện thoại</label>
                    <input class="chat-form__input" type="tel" placeholder="09xxxxxxxx"
                           @bind="_phone" @bind:event="oninput" />
                </div>
                <div class="chat-form__group">
                    <label class="chat-form__label">Email *</label>
                    <input class="chat-form__input" type="email" placeholder="email@example.com"
                           @bind="_email" @bind:event="oninput" />
                </div>

                <button class="chat-form__submit" @onclick="StartChat"
                        disabled="@(!CanStartChat || _loading)">
                    @if (_loading)
                    {
                        <i class="bi bi-arrow-clockwise admin-spin"></i>
                    }
                    else
                    {
                        <span>Bắt đầu chat <i class="bi bi-arrow-right"></i></span>
                    }
                </button>
            </div>
        }
        else if (_state == ChatState.Chat)
        {
            <div class="chat-messages" id="chatMessages">
                @for (int i = 0; i < _messages.Count; i++)
                {
                    ChatMessageDto msg = _messages[i];
                    bool isUnread = !msg.IsFromUser && _unreadDividerIndex >= 0 && i >= _unreadDividerIndex;

                    @if (i == _unreadDividerIndex)
                    {
                        <div class="chat-unread-divider">
                            <span>Tin nhắn mới</span>
                        </div>
                    }

                    <div class="chat-msg @(msg.IsFromUser ? "chat-msg--user" : "chat-msg--admin") @(isUnread ? "chat-msg--unread" : "") @(msg.Id == 0 ? "chat-msg--pending" : "")">
                        <div class="chat-msg__bubble">@msg.Content</div>
                        <div class="chat-msg__time">
                            @msg.SentAt.ToLocalTime().ToString("HH:mm")
                            @if (msg.IsFromUser)
                            {
                                if (_adminReadUpToId > 0 && msg.Id <= _adminReadUpToId)
                                {
                                    <i class="bi bi-check-all chat-msg__ticks chat-msg__ticks--read" title="Đã đọc"></i>
                                }
                                else
                                {
                                    <i class="bi bi-check chat-msg__ticks" title="Đã gửi"></i>
                                }
                            }
                        </div>
                    </div>
                }

                @if (_messages.Count == 0)
                {
                    <div style="text-align:center; color:#6b7280; font-size:0.8rem; margin-top:1rem;">
                        Gửi tin nhắn để bắt đầu cuộc trò chuyện 👋
                    </div>
                }

                @if (_otherIsTyping)
                {
                    <div class="chat-msg chat-msg--admin">
                        <div class="chat-typing">
                            <span></span><span></span><span></span>
                        </div>
                    </div>
                }
            </div>

            <div class="chat-input">
                <textarea class="chat-input__field" rows="1" placeholder="Nhập tin nhắn..."
                          value="@_inputText"
                          @oninput="OnTypingInput"
                          @onkeydown="OnKeyDown"></textarea>
                <button class="chat-input__send" @onclick="SendMessage"
                        disabled="@(string.IsNullOrWhiteSpace(_inputText) || _sending)">
                    <i class="bi bi-send-fill"></i>
                </button>
            </div>
        }
    </div>
}

<button class="chat-fab" @onclick="ToggleOpen" title="Chat với mình">
    @if (_state == ChatState.Closed)
    {
        <i class="bi bi-chat-dots-fill"></i>
        @if (_unreadCount > 0)
        {
            <span class="chat-fab__badge">@(_unreadCount > 9 ? "9+" : _unreadCount.ToString())</span>
        }
    }
    else
    {
        <i class="bi bi-chevron-down"></i>
    }
</button>
