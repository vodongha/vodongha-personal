@rendermode InteractiveServer

<aside class="admin-sidebar">
    <div class="admin-sidebar__logo">
        <span>vdh</span><span class="dot">.</span><span>admin</span>
    </div>
    <nav class="admin-nav">
        <a href="/admin" class="admin-nav__item @(IsActive("/admin", exact: true) ? "admin-nav__item--active" : "")"><i class="bi bi-grid"></i> Dashboard</a>
        <a href="/admin/skills" class="admin-nav__item @(IsActive("/admin/skills") ? "admin-nav__item--active" : "")"><i class="bi bi-bar-chart"></i> Skills</a>
        <a href="/admin/projects" class="admin-nav__item @(IsActive("/admin/projects") ? "admin-nav__item--active" : "")"><i class="bi bi-folder2"></i> Projects</a>
        <a href="/admin/education" class="admin-nav__item @(IsActive("/admin/education") ? "admin-nav__item--active" : "")"><i class="bi bi-mortarboard"></i> Education</a>
        <a href="/admin/experience" class="admin-nav__item @(IsActive("/admin/experience") ? "admin-nav__item--active" : "")"><i class="bi bi-briefcase"></i> Experience</a>
        <a href="/admin/blog" class="admin-nav__item @(IsActive("/admin/blog") ? "admin-nav__item--active" : "")"><i class="bi bi-file-text"></i> Blog</a>
        <a href="/admin/contacts" class="admin-nav__item @(IsActive("/admin/contacts") ? "admin-nav__item--active" : "")">
            <i class="bi bi-envelope"></i> Messages
            @if (_unreadMessagesCount > 0) { <span class="admin-badge-count">@_unreadMessagesCount</span> }
        </a>
        <a href="/admin/chats" class="admin-nav__item @(IsActive("/admin/chats") ? "admin-nav__item--active" : "")">
            <i class="bi bi-chat-dots"></i> Chats
            @if (_unreadChatCount > 0) { <span class="admin-badge-count">@_unreadChatCount</span> }
        </a>
        <a href="/admin/settings" class="admin-nav__item @(IsActive("/admin/settings") ? "admin-nav__item--active" : "")"><i class="bi bi-gear"></i> Thông tin</a>
    </nav>
    <form method="post" action="/admin/logout" class="admin-sidebar__logout">
        <button type="submit" class="admin-nav__item admin-nav__item--logout"><i class="bi bi-box-arrow-left"></i> Đăng xuất</button>
    </form>
</aside>
