@rendermode InteractiveServer
@inject AdminLocalizationService Loc

<aside class="admin-sidebar">
    <div class="admin-sidebar__logo">
        <span>vdh</span><span class="dot">.</span><span>admin</span>
    </div>
    <nav class="admin-nav">
        <a href="/admin" class="admin-nav__item admin-nav__item--pinned @(IsActive("/admin", exact: true) ? "admin-nav__item--active" : "")"><i class="bi bi-grid"></i> @Loc.T("Dashboard")</a>
        <a href="/admin/skills" class="admin-nav__item @(IsActive("/admin/skills") ? "admin-nav__item--active" : "")"><i class="bi bi-bar-chart"></i> @Loc.T("Skills")</a>
        <a href="/admin/projects" class="admin-nav__item @(IsActive("/admin/projects") ? "admin-nav__item--active" : "")"><i class="bi bi-folder2"></i> @Loc.T("Projects")</a>
        <a href="/admin/education" class="admin-nav__item @(IsActive("/admin/education") ? "admin-nav__item--active" : "")"><i class="bi bi-mortarboard"></i> @Loc.T("Education")</a>
        <a href="/admin/experience" class="admin-nav__item @(IsActive("/admin/experience") ? "admin-nav__item--active" : "")"><i class="bi bi-briefcase"></i> @Loc.T("Experience")</a>
        <a href="/admin/blog" class="admin-nav__item @(IsActive("/admin/blog") ? "admin-nav__item--active" : "")"><i class="bi bi-file-text"></i> @Loc.T("Blog")</a>
        <a href="/admin/contacts" class="admin-nav__item @(IsActive("/admin/contacts") ? "admin-nav__item--active" : "")">
            <i class="bi bi-envelope"></i> @Loc.T("Messages")
            @if (_unreadMessagesCount > 0) { <span class="admin-badge-count">@_unreadMessagesCount</span> }
        </a>
        <a href="/admin/chats" class="admin-nav__item @(IsActive("/admin/chats") ? "admin-nav__item--active" : "")">
            <i class="bi bi-chat-dots"></i> @Loc.T("Chats")
            @if (_unreadChatCount > 0) { <span class="admin-badge-count">@_unreadChatCount</span> }
        </a>
        <a href="/admin/health" class="admin-nav__item @(IsActive("/admin/health") ? "admin-nav__item--active" : "")"><i class="bi bi-activity"></i> @Loc.T("Health")</a>
        <a href="/admin/costs" class="admin-nav__item @(IsActive("/admin/costs") ? "admin-nav__item--active" : "")"><i class="bi bi-currency-dollar"></i> @Loc.T("Costs")</a>
        <a href="/admin/api-keys" class="admin-nav__item @(IsActive("/admin/api-keys") ? "admin-nav__item--active" : "")"><i class="bi bi-key"></i> @Loc.T("API Keys")</a>
        <a href="/admin/settings" class="admin-nav__item @(IsActive("/admin/settings") ? "admin-nav__item--active" : "")"><i class="bi bi-gear"></i> @Loc.T("Settings")</a>
    </nav>
    <button class="admin-lang-toggle" @onclick="ToggleLang" title="Switch language">
        <i class="bi bi-translate admin-lang-toggle__icon"></i>
        <span class="admin-lang-toggle__label">
            <span class="@(Loc.Lang == "VI" ? "admin-lang-toggle__opt--active" : "admin-lang-toggle__opt")">VI</span>
            <span class="admin-lang-toggle__sep">|</span>
            <span class="@(Loc.Lang == "EN" ? "admin-lang-toggle__opt--active" : "admin-lang-toggle__opt")">EN</span>
        </span>
    </button>
    <form method="post" action="/admin/logout" class="admin-sidebar__logout">
        <button type="submit" class="admin-nav__item admin-nav__item--logout"><i class="bi bi-box-arrow-left"></i> @Loc.T("Logout")</button>
    </form>
</aside>
