# TEMPLATE — Copy file này thành .env và điền giá trị thật
# File .env KHÔNG được commit lên git
# ══════════════════════════════════════════════════════════════

# PostgreSQL connection string (Neon hoặc server khác)
DB_CONNECTION_STRING=Host=your-host;Database=your-db;Username=your-user;Password=your-password;SSL Mode=Require;Trust Server Certificate=true

# Chỉ dùng cho docker-compose.dev.yml (local postgres)
POSTGRES_PASSWORD=your-local-password
