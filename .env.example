# TEMPLATE — Copy this file to .env and fill in real values
# The .env file must NOT be committed to git
# ══════════════════════════════════════════════════════════════

# PostgreSQL connection string (Neon or other server)
DB_CONNECTION_STRING=Host=your-host;Database=your-db;Username=your-user;Password=your-password;SSL Mode=Require;Trust Server Certificate=true

# Only used by docker-compose.dev.yml (local postgres)
POSTGRES_PASSWORD=your-local-password
