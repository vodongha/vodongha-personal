# TEMPLATE — Copy this file to .env and fill in real values
# The .env file must NOT be committed to git
# ══════════════════════════════════════════════════════════════

# Oracle Autonomous Database (ODP.NET, wallet-based mTLS).
# The unzipped ADB wallet must be present at ./wallet (mounted to /app/wallet by
# docker-compose.yml, with TNS_ADMIN=/app/wallet). Data Source is a net-service
# alias from the wallet's tnsnames.ora.
DB_CONNECTION_STRING=User Id=YOUR_SCHEMA;Password=your-password;Data Source=your_tp;
