<section class="section skills" id="skills">
    <div class="section__header">
        <span class="section__label">@Lang.T("skills.label")</span>
        <h2 class="section__title">@Lang.T("skills.title")</h2>
        <p class="section__subtitle">@Lang.T("skills.subtitle")</p>
    </div>

    @if (_grouped is null)
    {
        <div class="skills-skel">
            @for (int c = 0; c < 3; c++)
            {
                <div class="skills-skel__cat">
                    <div class="skills-skel__cat-title"></div>
                    @for (int i = 0; i < 4; i++)
                    {
                        <div class="skills-skel__item">
                            <div class="skills-skel__item-header">
                                <div class="skills-skel__item-name"></div>
                                <div class="skills-skel__item-pct"></div>
                            </div>
                            <div class="skills-skel__bar"></div>
                        </div>
                    }
                </div>
            }
        </div>
    }
    else
    {
        <div class="skills__grid">
            @{ int idx = 0; }
            @foreach (KeyValuePair<string, List<Skill>> category in _grouped)
            {
                <div class="skills__category @(idx >= InitialCount ? "section__overflow" : "")" hidden="@(idx >= InitialCount)">
                    <h3 class="skills__category-title">@category.Key</h3>
                    <ul class="skills__list">
                        @foreach (Skill skill in category.Value)
                        {
                            <li class="skills__item">
                                <div class="skills__item-header">
                                    <span class="skills__item-name">
                                        @if (skill.Icon.StartsWith("bi "))
                                        {
                                            <i class="@skill.Icon"></i>
                                        }
                                        else
                                        {
                                            <i class="@skill.Icon colored"></i>
                                        }
                                        @skill.Name
                                    </span>
                                    <span class="skills__item-pct">@skill.Proficiency%</span>
                                </div>
                                <div class="skills__bar">
                                    <div class="skills__bar-fill" style="width: @(skill.Proficiency)%"></div>
                                </div>
                            </li>
                        }
                    </ul>
                </div>
                idx++;
            }
        </div>

        @if (_grouped.Count > InitialCount)
        {
            <div class="section__expand">
                <button type="button" class="section__expand-btn" aria-expanded="false" onclick="sectionToggle(this)">
                    <i class="bi bi-chevron-down"></i>
                    <span data-show>@Lang.T("common.showmore")</span>
                    <span data-hide hidden>@Lang.T("common.showless")</span>
                </button>
            </div>
        }
    }
</section>
