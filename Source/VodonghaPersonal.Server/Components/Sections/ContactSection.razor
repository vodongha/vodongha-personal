<section class="section contact" id="contact">
    <div class="section__header">
        <span class="section__label">@Lang.T("contact.label")</span>
        <h2 class="section__title">@Lang.T("contact.title")</h2>
        <p class="section__subtitle">@Lang.T("contact.subtitle")</p>
    </div>

    <div class="contact__inner">
        <div class="contact__info">
            @if (!string.IsNullOrEmpty(_location))
            {
                <div class="contact__info-item">
                    <div class="contact__info-icon"><i class="bi bi-geo-alt"></i></div>
                    <div>
                        <div class="contact__info-label">@(Lang.IsVi ? "Địa chỉ" : "Location")</div>
                        <div class="contact__info-value">@_location</div>
                    </div>
                </div>
            }
            @if (!string.IsNullOrEmpty(_email))
            {
                <a href="mailto:@_email" class="contact__info-item contact__info-item--link">
                    <div class="contact__info-icon"><i class="bi bi-envelope"></i></div>
                    <div>
                        <div class="contact__info-label">Email</div>
                        <div class="contact__info-value">@_email</div>
                    </div>
                </a>
            }
            @if (!string.IsNullOrEmpty(_github))
            {
                <a href="@_github" target="_blank" rel="noopener" class="contact__info-item contact__info-item--link">
                    <div class="contact__info-icon"><i class="bi bi-github"></i></div>
                    <div>
                        <div class="contact__info-label">GitHub</div>
                        <div class="contact__info-value">@_github.Replace("https://", "").Replace("www.", "")</div>
                    </div>
                </a>
            }
            @if (!string.IsNullOrEmpty(_linkedin))
            {
                <a href="@_linkedin" target="_blank" rel="noopener" class="contact__info-item contact__info-item--link">
                    <div class="contact__info-icon"><i class="bi bi-linkedin"></i></div>
                    <div>
                        <div class="contact__info-label">LinkedIn</div>
                        <div class="contact__info-value">@_linkedin.Replace("https://", "").Replace("www.", "")</div>
                    </div>
                </a>
            }
            @if (!string.IsNullOrEmpty(_facebook))
            {
                <a href="@_facebook" target="_blank" rel="noopener" class="contact__info-item contact__info-item--link">
                    <div class="contact__info-icon"><i class="bi bi-facebook"></i></div>
                    <div>
                        <div class="contact__info-label">Facebook</div>
                        <div class="contact__info-value">@_facebook.Replace("https://", "").Replace("www.", "")</div>
                    </div>
                </a>
            }
        </div>

        @if (_sent)
        {
            <div class="contact__form contact__success">
                <i class="bi bi-check-circle"></i>
                <h3>@Lang.T("contact.success")</h3>
            </div>
        }
        else
        {
            <div class="contact__form">
                <div class="contact__field">
                    <label class="contact__label">@Lang.T("contact.name")<span class="required">*</span></label>
                    <input class="contact__input @(NameError != null ? "invalid" : "")"
                           type="text"
                           maxlength="100"
                           value="@_model.Name"
                           @oninput="e => _model.Name = e.Value?.ToString() ?? string.Empty"
                           @onblur="ValidateName" />
                    @if (NameError != null)
                    {
                        <span class="validation-message">@NameError</span>
                    }
                </div>

                <div class="contact__field">
                    <label class="contact__label">@Lang.T("contact.email")<span class="required">*</span></label>
                    <input class="contact__input @(EmailError != null ? "invalid" : "")"
                           type="email"
                           maxlength="254"
                           value="@_model.Email"
                           @oninput="e => _model.Email = e.Value?.ToString() ?? string.Empty"
                           @onblur="ValidateEmail" />
                    @if (EmailError != null)
                    {
                        <span class="validation-message">@EmailError</span>
                    }
                </div>

                <div class="contact__field">
                    <label class="contact__label">@(Lang.IsVi ? "Tiêu đề" : "Subject")<span class="required">*</span></label>
                    <input class="contact__input @(SubjectError != null ? "invalid" : "")"
                           type="text"
                           maxlength="200"
                           value="@_model.Subject"
                           @oninput="e => _model.Subject = e.Value?.ToString() ?? string.Empty"
                           @onblur="ValidateSubject" />
                    @if (SubjectError != null)
                    {
                        <span class="validation-message">@SubjectError</span>
                    }
                </div>

                <div class="contact__field">
                    <label class="contact__label">@Lang.T("contact.message")<span class="required">*</span></label>
                    <textarea class="contact__textarea @(MessageError != null ? "invalid" : "")"
                              maxlength="5000"
                              @oninput="e => _model.Message = e.Value?.ToString() ?? string.Empty"
                              @onblur="ValidateMessage">@_model.Message</textarea>
                    @if (MessageError != null)
                    {
                        <span class="validation-message">@MessageError</span>
                    }
                </div>

                <button type="button" class="contact__submit" @onclick="HandleSubmit" disabled="@(!CanSend || _sending)">
                    @if (_sending)
                    {
                        <span>@(Lang.IsVi ? "Đang gửi..." : "Sending...")</span>
                    }
                    else
                    {
                        <i class="bi bi-send"></i>
                        <span>@Lang.T("contact.send")</span>
                    }
                </button>
            </div>
        }
    </div>
</section>
