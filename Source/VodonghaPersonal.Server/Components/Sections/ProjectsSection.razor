<section class="section projects" id="projects">
    <div class="section__header">
        <span class="section__label">@Lang.T("projects.label")</span>
        <h2 class="section__title">@Lang.T("projects.title")</h2>
        <p class="section__subtitle">@Lang.T("projects.subtitle")</p>
    </div>

    @if (_projects is null)
    {
        <div class="projects-skel">
            @for (int i = 0; i < 6; i++)
            {
                <div class="projects-skel__card">
                    <div class="projects-skel__img"></div>
                    <div class="projects-skel__body">
                        <div class="projects-skel__title"></div>
                        <div class="projects-skel__desc"></div>
                        <div class="projects-skel__desc2"></div>
                        <div class="projects-skel__tags">
                            <div class="projects-skel__tag"></div>
                            <div class="projects-skel__tag"></div>
                            <div class="projects-skel__tag"></div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="projects__grid">
            @{ int idx = 0; }
            @foreach (Project project in _projects)
            {
                <div class="@(idx >= InitialCount ? "section__overflow" : "")" hidden="@(idx >= InitialCount)">
                    <ProjectCard Item="project" />
                </div>
                idx++;
            }
        </div>

        @if (_projects.Count > InitialCount)
        {
            <div class="section__expand">
                <button type="button" class="section__expand-btn" aria-expanded="false" onclick="sectionToggle(this)">
                    <i class="bi bi-chevron-down"></i>
                    <span data-show>@Lang.T("common.showmore")</span>
                    <span data-hide hidden>@Lang.T("common.showless")</span>
                </button>
            </div>
        }
    }
</section>
