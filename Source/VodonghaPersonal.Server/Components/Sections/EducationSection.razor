<section class="section education" id="education">
    <div class="section__header">
        <span class="section__label">@Lang.T("edu.label")</span>
        <h2 class="section__title">@Lang.T("edu.title")</h2>
    </div>

    @if (_items is null)
    {
        <div class="timeline-skel">
            @for (int i = 0; i < 3; i++)
            {
                <div class="timeline-skel__item">
                    <div class="timeline-skel__dot"></div>
                    <div class="timeline-skel__content">
                        <div class="timeline-skel__role"></div>
                        <div class="timeline-skel__period"></div>
                        <div class="timeline-skel__company"></div>
                        <div class="timeline-skel__desc"></div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="timeline">
            @{ int idx = 0; }
            @foreach (Education item in _items)
            {
                <div class="timeline__item @(idx >= InitialCount ? "section__overflow" : "")">
                    <div class="timeline__dot"></div>
                    <div class="timeline__content">
                        <div class="timeline__header">
                            <h3 class="timeline__role">
                                @if (!string.IsNullOrEmpty(item.WebsiteUrl))
                                {
                                    <a href="@item.WebsiteUrl" target="_blank" class="timeline__company-link">@item.School</a>
                                }
                                else
                                {
                                    @item.School
                                }
                            </h3>
                            <span class="timeline__period">@item.StartYear — @(item.EndYear?.ToString() ?? "Present")</span>
                        </div>
                        @{
                            string degreeLine = string.Join(" · ", new[] { item.Degree, item.Field }.Where(s => !string.IsNullOrWhiteSpace(s)));
                        }
                        @if (!string.IsNullOrEmpty(degreeLine))
                        {
                            <p class="timeline__company">
                                <i class="bi bi-mortarboard"></i> @degreeLine
                            </p>
                        }
                        @{
                            string? desc = Lang.IsVi ? item.Description : (item.DescriptionEn ?? item.Description);
                        }
                        @if (!string.IsNullOrEmpty(desc))
                        {
                            <p class="timeline__desc">@desc</p>
                        }
                    </div>
                </div>
                idx++;
            }
        </div>

        @if (_items.Count > InitialCount)
        {
            <div class="section__expand">
                <button type="button" class="section__expand-btn" aria-expanded="false" onclick="sectionToggle(this)">
                    <i class="bi bi-chevron-down"></i>
                    <span data-show>@Lang.T("common.showmore")</span>
                    <span data-hide hidden>@Lang.T("common.showless")</span>
                </button>
            </div>
        }
    }
</section>
