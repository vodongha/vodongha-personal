@if (Show)
{
    <div class="admin-modal-overlay" @onclick="Cancel">
        <div class="admin-modal admin-modal--sm" @onclick:stopPropagation>
            <h2 class="admin-modal__title" style="color:#f87171">Confirm delete</h2>
            <p style="margin-bottom:1rem;opacity:.7">@Message</p>
            <p style="margin-bottom:0.5rem;font-size:0.8rem;opacity:.5">Type <strong style="opacity:1;color:#f87171">Delete</strong> to confirm</p>
            <input class="admin-form__input" @bind="_input" @bind:event="oninput"
                   placeholder="Delete" autocomplete="off" />
            <div class="admin-modal__footer">
                <button class="admin-btn admin-btn--ghost" @onclick="Cancel">Cancel</button>
                <button class="admin-btn admin-btn--danger" @onclick="Confirm" disabled="@(_input != "Delete")">Delete</button>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public bool Show { get; set; }
    [Parameter] public string Message { get; set; } = "Are you sure you want to delete this item?";
    [Parameter] public EventCallback OnConfirm { get; set; }
    [Parameter] public EventCallback OnCancel { get; set; }

    private string _input = "";

    protected override void OnParametersSet()
    {
        if (!Show) { _input = ""; }
    }

    private async Task Confirm()
    {
        if (_input != "Delete") { return; }
        _input = "";
        await OnConfirm.InvokeAsync();
    }

    private async Task Cancel()
    {
        _input = "";
        await OnCancel.InvokeAsync();
    }
}
