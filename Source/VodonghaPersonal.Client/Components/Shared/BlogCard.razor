<a class="blog-card" href="/blog/@Item.Slug">
    @if (!string.IsNullOrEmpty(Item.CoverImageUrl))
    {
        <div class="blog-card__cover">
            <img src="@Item.CoverImageUrl" alt="@(Lang.IsVi ? Item.Title : (Item.TitleEn ?? Item.Title))" loading="lazy" />
        </div>
    }
    <div class="blog-card__body">
        <div class="blog-card__meta-row">
            <span class="blog-card__date">@Tz.ToUserTime(Item.CreatedAt).ToString("dd/MM/yyyy")</span>
            <div class="blog-card__meta-right">
                @if (Item.ViewCount > 0)
                {
                    <span class="blog-card__views"><i class="bi bi-eye"></i> @Item.ViewCount</span>
                }
                <span class="blog-card__read-time"><i class="bi bi-clock"></i> @ReadingMinutes @Lang.T("blog.readtime")</span>
            </div>
        </div>
        <h3 class="blog-card__title">@(Lang.IsVi ? Item.Title : (Item.TitleEn ?? Item.Title))</h3>
        <p class="blog-card__summary">@(Lang.IsVi ? Item.Summary : (Item.SummaryEn ?? Item.Summary))</p>

        @if (!string.IsNullOrEmpty(Item.Tags))
        {
            <div class="blog-card__tags">
                @foreach (string tag in Item.Tags.Split(',', StringSplitOptions.RemoveEmptyEntries).Take(3))
                {
                    <span class="blog-card__tag">@tag.Trim()</span>
                }
            </div>
        }

        <span class="blog-card__read-more">
            @Lang.T("blog.read") <i class="bi bi-arrow-right"></i>
        </span>
    </div>
</a>
