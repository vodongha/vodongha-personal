@page "/admin/contacts"
@layout AdminLayout
@attribute [Authorize]
@rendermode @(new InteractiveAutoRenderMode(prerender: false))
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.QuickGrid
@using VodonghaPersonal.Shared.Models

<div class="admin-shell">
    <AdminNav />

    <main class="admin-main">
        <header class="admin-header">
            <h1 class="admin-header__title">@Loc.T("Messages") @if (_unreadContacts > 0) { <span class="admin-badge" style="background:rgba(99,102,241,.15);color:#818cf8">@_unreadContacts @Loc.T("unread")</span> }</h1>
            <AdminBreadcrumb />
            @if (_unreadContacts > 0)
            {
                <button class="admin-btn admin-btn--ghost" @onclick="MarkAllRead"><i class="bi bi-check2-all"></i> @Loc.T("Mark all read")</button>
            }
        </header>
        <div class="admin-content">

        @if (_loading)
        {
            <div class="admin-tbl-skel">
                <div class="admin-tbl-skel__head">
                    <div class="admin-tbl-skel__cell admin-tbl-skel__cell--sm"></div>
                    <div class="admin-tbl-skel__cell admin-tbl-skel__cell--md"></div>
                    <div class="admin-tbl-skel__cell admin-tbl-skel__cell--md"></div>
                    <div class="admin-tbl-skel__cell admin-tbl-skel__cell--lg"></div>
                    <div class="admin-tbl-skel__cell admin-tbl-skel__cell--md"></div>
                    <div class="admin-tbl-skel__cell admin-tbl-skel__cell--md"></div>
                </div>
                @for (int i = 0; i < 8; i++)
                {
                    <div class="admin-tbl-skel__row">
                        <div class="admin-tbl-skel__cell admin-tbl-skel__cell--sm"></div>
                        <div class="admin-tbl-skel__cell admin-tbl-skel__cell--md"></div>
                        <div class="admin-tbl-skel__cell admin-tbl-skel__cell--md"></div>
                        <div class="admin-tbl-skel__cell admin-tbl-skel__cell--lg"></div>
                        <div class="admin-tbl-skel__cell admin-tbl-skel__cell--md"></div>
                        <div class="admin-tbl-skel__cell admin-tbl-skel__cell--btn"></div>
                    </div>
                }
            </div>
        }
        <div style="@(_loading ? "display:none" : null)">
            <div class="admin-toolbar">
                <div class="admin-select-wrap">
                    <select class="admin-page-size" @onchange="SetPageSize">
                        <option value="5">5 / @Loc.T("page")</option>
                        <option value="10" selected>10 / @Loc.T("page")</option>
                        <option value="20">20 / @Loc.T("page")</option>
                        <option value="50">50 / @Loc.T("page")</option>
                    </select>
                </div>
                <div class="admin-search-wrap">
                    <i class="bi bi-search admin-search-wrap__icon"></i>
                    <input class="admin-form__input admin-search" value="@_search" @oninput="OnSearch" placeholder="@Loc.T("Search name, email, subject...")" />
                </div>
            </div>

            <QuickGrid TGridItem="ContactMessage" @ref="_grid" ItemsProvider="LoadGrid" Pagination="_pagination" class="quickgrid">
                <TemplateColumn Title="" Sortable="false">
                    @if (!context.IsRead) { <span class="admin-unread-dot" title="Unread"></span> }
                </TemplateColumn>
                <TemplateColumn Title="@Loc.T("Name")" Sortable="false">
                    <strong>@context.Name</strong>
                </TemplateColumn>
                <TemplateColumn Title="@Loc.T("Email")" Sortable="false">
                    <a href="mailto:@context.Email">@context.Email</a>
                </TemplateColumn>
                <PropertyColumn Property="m => m.Subject" Title="@Loc.T("Subject")" Sortable="true" />
                <PropertyColumn Property="m => m.SentAt" Title="@Loc.T("Date")" Format="yyyy-MM-dd HH:mm" Sortable="true" />
                <TemplateColumn Title="@Loc.T("Actions")">
                    <div class="admin-table__actions">
                        <button class="admin-btn admin-btn--sm admin-btn--ghost" @onclick="() => OpenMessage(context)" title="@Loc.T("View")"><i class="bi bi-eye"></i></button>
                        <button class="admin-btn admin-btn--sm admin-btn--danger" @onclick="() => ConfirmDelete(context.Rid)" title="@Loc.T("Delete")"><i class="bi bi-trash"></i></button>
                    </div>
                </TemplateColumn>
            </QuickGrid>
            <Paginator State="_pagination" />

            @if (!_loading && _total == 0)
            {
                <div class="admin-empty">
                    <i class="bi bi-inbox" style="font-size:3rem;opacity:.3"></i>
                    <p style="margin-top:.75rem;opacity:.5">@(string.IsNullOrEmpty(_search) ? Loc.T("No messages yet.") : Loc.T("No results found."))</p>
                </div>
            }
        </div>

        @if (Selected is not null)
        {
            <div class="admin-modal-overlay" @onclick="CloseMessage">
                <div class="admin-modal" @onclick:stopPropagation>
                    <h2 class="admin-modal__title">@Selected.Subject</h2>
                    <p style="margin-bottom:.25rem"><strong>@Loc.T("From:")</strong> @Selected.Name &lt;<a href="mailto:@Selected.Email">@Selected.Email</a>&gt;</p>
                    <p class="admin-contact-meta"><small>@Selected.SentAt.ToString("dddd, MMMM d yyyy - HH:mm UTC")</small></p>
                    <div class="admin-message-body">@((MarkupString)System.Web.HttpUtility.HtmlEncode(Selected.Message).Replace("\n", "<br/>"))</div>
                    <div class="admin-modal__footer">
                        <a class="admin-btn admin-btn--ghost" href="mailto:@Selected.Email?subject=Re: @Uri.EscapeDataString(Selected.Subject)"><i class="bi bi-reply"></i> @Loc.T("Reply")</a>
                        <button type="button" class="admin-btn admin-btn--primary" @onclick="CloseMessage">@Loc.T("Cancel")</button>
                    </div>
                </div>
            </div>
        }

        <ConfirmDialog Show="_confirmShow" OnConfirm="ExecuteDelete" OnCancel="() => _confirmShow = false" />
        </div>
        <AdminFooter />
    </main>
</div>
