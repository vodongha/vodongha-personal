@rendermode @(new InteractiveWebAssemblyRenderMode(prerender: false))
<div class="toast-container">
    @foreach (ToastItem t in ToastSvc.Toasts)
    {
        <div class="toast @(t.Success ? "toast--success" : "toast--error")" @key="t.Id">
            <i class="bi @(t.Success ? "bi-check-circle-fill" : "bi-x-circle-fill")"></i>
            <span>@t.Message</span>
            <button type="button" class="toast__close" @onclick="() => ToastSvc.Remove(t.Id)">
                <i class="bi bi-x"></i>
            </button>
        </div>
    }
</div>
