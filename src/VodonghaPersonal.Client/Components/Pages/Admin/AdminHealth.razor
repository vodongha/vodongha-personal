@page "/admin/health"
@layout AdminLayout
@attribute [Authorize]
@rendermode InteractiveAuto
@using Microsoft.AspNetCore.Authorization

<div class="admin-shell">
    <AdminNav />

    <main class="admin-main">
        <header class="admin-header">
            <h1 class="admin-header__title">@Loc.T("Server Status")</h1>
            <div class="health-refresh">
                <span class="health-refresh__label">@Loc.T("Auto-refresh"): @_countdown s</span>
                <button type="button" class="admin-btn admin-btn--ghost admin-btn--sm" @onclick="Refresh">
                    <i class="bi bi-arrow-clockwise @(_isRefreshing ? "admin-spin" : "")"></i> @Loc.T("Refresh")
                </button>
            </div>
        </header>

        <!-- Status cards -->
        <div id="health-stat-cards" class="health-cards" data-saved-order="@_statOrder">
            <div class="health-card @(_latest?.DbHealthy == true ? "health-card--ok" : "health-card--error")" data-card-id="stat-server">
                <i class="bi bi-grip-vertical cost-card-drag-handle"></i>
                <div class="health-card__icon">
                    <i class="bi @(_latest?.DbHealthy == true ? "bi-server" : "bi-exclamation-triangle")"></i>
                </div>
                <div class="health-card__body">
                    <div class="health-card__label">@Loc.T("Server")</div>
                    <div class="health-card__value">@(_latest != null ? Loc.T("Online") : "—")</div>
                </div>
                <div class="health-card__dot health-card__dot--@(_latest?.DbHealthy == true ? "ok" : "error")"></div>
            </div>

            <div class="health-card @(_latest?.DbHealthy == true ? "health-card--ok" : "health-card--error")" data-card-id="stat-db">
                <i class="bi bi-grip-vertical cost-card-drag-handle"></i>
                <div class="health-card__icon">
                    <i class="bi bi-database@(_latest?.DbHealthy == true ? "-check" : "-x")"></i>
                </div>
                <div class="health-card__body">
                    <div class="health-card__label">@Loc.T("Database")</div>
                    <div class="health-card__value">
                        @if (_latest?.DbHealthy == true)
                        {
                            <span>@_latest.DbPingMs ms</span>
                        }
                        else
                        {
                            <span>@Loc.T("Unreachable")</span>
                        }
                    </div>
                </div>
                <div class="health-card__dot health-card__dot--@(_latest?.DbHealthy == true ? "ok" : "error")"></div>
            </div>

            <div class="health-card" data-card-id="stat-uptime">
                <i class="bi bi-grip-vertical cost-card-drag-handle"></i>
                <div class="health-card__icon"><i class="bi bi-clock-history"></i></div>
                <div class="health-card__body">
                    <div class="health-card__label">@Loc.T("Uptime")</div>
                    <div class="health-card__value">@FormatUptime(_uptimeSeconds)</div>
                </div>
            </div>

            <div class="health-card" data-card-id="stat-memory">
                <i class="bi bi-grip-vertical cost-card-drag-handle"></i>
                <div class="health-card__icon"><i class="bi bi-memory"></i></div>
                <div class="health-card__body">
                    <div class="health-card__label">@Loc.T("Memory")</div>
                    <div class="health-card__value">@(_latest != null ? $"{_latest.MemoryMb} MB" : "—")</div>
                </div>
            </div>

            <div class="health-card" data-card-id="stat-threads">
                <i class="bi bi-grip-vertical cost-card-drag-handle"></i>
                <div class="health-card__icon"><i class="bi bi-cpu"></i></div>
                <div class="health-card__body">
                    <div class="health-card__label">@Loc.T("Threads")</div>
                    <div class="health-card__value">@(_latest?.ThreadCount.ToString() ?? "—")</div>
                </div>
            </div>

            <div class="health-card" data-card-id="stat-started">
                <i class="bi bi-grip-vertical cost-card-drag-handle"></i>
                <div class="health-card__icon"><i class="bi bi-calendar3"></i></div>
                <div class="health-card__body">
                    <div class="health-card__label">@Loc.T("Started at")</div>
                    <div class="health-card__value health-card__value--sm">@Tz.ToUserTime(_startedAt).ToString("dd/MM HH:mm")</div>
                </div>
            </div>
        </div>

        <!-- Charts row -->
        <div id="health-chart-cards" class="health-charts" data-saved-order="@_chartOrder">
            <div class="health-chart-card" data-card-id="chart-memory-card">
                <div class="health-chart-card__header">
                    <i class="bi bi-grip-vertical cost-card-drag-handle"></i>
                    <span class="health-chart-card__title">
                        <i class="bi bi-memory"></i> @Loc.T("Memory Usage")
                    </span>
                    <span class="health-chart-card__unit">MB</span>
                </div>
                <div class="health-chart-card__body">
                    <canvas id="chart-memory"></canvas>
                </div>
            </div>

            <div class="health-chart-card" data-card-id="chart-db-card">
                <div class="health-chart-card__header">
                    <i class="bi bi-grip-vertical cost-card-drag-handle"></i>
                    <span class="health-chart-card__title">
                        <i class="bi bi-database"></i> @Loc.T("DB Response Time")
                    </span>
                    <span class="health-chart-card__unit">ms</span>
                </div>
                <div class="health-chart-card__body">
                    <canvas id="chart-db"></canvas>
                </div>
            </div>
        </div>

        <!-- Snapshot table -->
        <div class="health-table-wrap">
            <div class="admin-toolbar">
                <div class="health-section-title" style="margin:0">@Loc.T("Recent snapshots")</div>
                <div class="admin-select-wrap">
                    <select class="admin-page-size" value="@_pageSize" @onchange="OnPageSizeChange">
                        <option value="5">5 / @Loc.T("page")</option>
                        <option value="10" selected>10 / @Loc.T("page")</option>
                        <option value="20">20 / @Loc.T("page")</option>
                        <option value="50">50 / @Loc.T("page")</option>
                    </select>
                </div>
            </div>

            <table class="quickgrid">
                <thead>
                    <tr>
                        <th class="sortable @(_sortCol == "Time"    ? (_sortAsc ? "col-sort-asc" : "col-sort-desc") : "")" @onclick='() => SortBy("Time")'>
                            @Loc.T("Time") <span class="sort-arrow">@SortIcon("Time")</span>
                        </th>
                        <th class="sortable @(_sortCol == "Memory"  ? (_sortAsc ? "col-sort-asc" : "col-sort-desc") : "")" @onclick='() => SortBy("Memory")'>
                            @Loc.T("Memory") <span class="sort-arrow">@SortIcon("Memory")</span>
                        </th>
                        <th class="sortable @(_sortCol == "DB Ping" ? (_sortAsc ? "col-sort-asc" : "col-sort-desc") : "")" @onclick='() => SortBy("DB Ping")'>
                            @Loc.T("DB Ping") <span class="sort-arrow">@SortIcon("DB Ping")</span>
                        </th>
                        <th class="sortable @(_sortCol == "Threads" ? (_sortAsc ? "col-sort-asc" : "col-sort-desc") : "")" @onclick='() => SortBy("Threads")'>
                            @Loc.T("Threads") <span class="sort-arrow">@SortIcon("Threads")</span>
                        </th>
                        <th class="sortable @(_sortCol == "Status"  ? (_sortAsc ? "col-sort-asc" : "col-sort-desc") : "")" @onclick='() => SortBy("Status")'>
                            @Loc.T("Status") <span class="sort-arrow">@SortIcon("Status")</span>
                        </th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (HealthSnapshotDto snap in Paged)
                    {
                        <tr>
                            <td style="color:#6b7280;font-size:.8rem;font-variant-numeric:tabular-nums">@Tz.ToUserTime(snap.Timestamp).ToString("HH:mm:ss")</td>
                            <td>@snap.MemoryMb MB</td>
                            <td>@(snap.DbHealthy ? $"{snap.DbPingMs} ms" : "—")</td>
                            <td>@snap.ThreadCount</td>
                            <td>
                                @if (snap.DbHealthy)
                                {
                                    <span class="health-badge health-badge--ok"><i class="bi bi-check-circle-fill"></i> OK</span>
                                }
                                else
                                {
                                    <span class="health-badge health-badge--error"><i class="bi bi-x-circle-fill"></i> Error</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>

            <div class="paginator">
                <span class="paginator-summary">@_snapshots.Count @Loc.T("items")</span>
                <nav>
                    <button type="button" @onclick="() => GoPage(0)" disabled="@(_page == 0)">«</button>
                    <button type="button" @onclick="() => GoPage(_page - 1)" disabled="@(_page == 0)">‹</button>
                    <span>@Loc.T("Page") @(_page + 1) / @TotalPages</span>
                    <button type="button" @onclick="() => GoPage(_page + 1)" disabled="@(_page >= TotalPages - 1)">›</button>
                    <button type="button" @onclick="() => GoPage(TotalPages - 1)" disabled="@(_page >= TotalPages - 1)">»</button>
                </nav>
            </div>
        </div>
    </main>
</div>
