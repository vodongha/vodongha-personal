@page "/admin/api-keys"
@layout AdminLayout
@attribute [Authorize]
@rendermode @(new InteractiveAutoRenderMode(prerender: false))
@using Microsoft.AspNetCore.Authorization

<div class="admin-shell">
    <AdminNav />

    <main class="admin-main">
        <header class="admin-header">
            <h1 class="admin-header__title">
                <i class="bi bi-key"></i> @Loc.T("API Keys")
            </h1>
            <div class="health-refresh">
                <span class="health-refresh__label">@Loc.T("Changes apply immediately")</span>
                <button type="button" class="admin-btn admin-btn--ghost admin-btn--sm" @onclick="LoadAsync" disabled="@_loading">
                    <i class="bi bi-arrow-clockwise @(_loading ? "admin-spin" : "")"></i> @Loc.T("Refresh")
                </button>
            </div>
        </header>

        <div class="ak-search-wrap">
            <i class="bi bi-search ak-search-wrap__icon"></i>
            <input class="ak-search-wrap__input"
                   type="search"
                   placeholder="@Loc.T("Search...")"
                   @bind="_search"
                   @bind:event="oninput" />
            @if (!string.IsNullOrEmpty(_search))
            {
                <button type="button" class="ak-search-wrap__clear" @onclick="() => _search = string.Empty">
                    <i class="bi bi-x-lg"></i>
                </button>
            }
        </div>

        <div class="apikey-info">
            <i class="bi bi-shield-lock"></i>
            @Loc.T("Values are encrypted in the database. DB overrides take effect immediately without redeployment. Leave blank to fall back to environment variables.")
        </div>

        @if (_loading)
        {
            <div class="apikeys-skel">
                @for (int s = 0; s < 3; s++)
                {
                    <div class="apikeys-skel__section">
                        <div class="apikeys-skel__head">
                            <div class="apikeys-skel__icon"></div>
                            <div class="apikeys-skel__title"></div>
                        </div>
                        <div class="apikeys-skel__rows">
                            @for (int r = 0; r < 4; r++)
                            {
                                <div class="apikeys-skel__row">
                                    <div class="apikeys-skel__label"></div>
                                    <div class="apikeys-skel__input"></div>
                                    <div class="apikeys-skel__btn"></div>
                                </div>
                            }
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            bool anyResult = Categories.Any(CategoryVisible);
            @if (!anyResult)
            {
                <div class="ak-no-results">
                    <i class="bi bi-search"></i>
                    <span>@Loc.T("No results")</span>
                </div>
            }
            @foreach (string category in Categories)
            {
                if (!CategoryVisible(category)) { continue; }
                List<ApiKeyDefinitionDto> defs = FilteredDefs(category).ToList();
                List<ApiKeyDefinitionDto> allDefs = _definitions.Where(d => d.Category == category).ToList();
                int setCount = allDefs.Count(d => !string.IsNullOrEmpty(_dbValues.GetValueOrDefault(d.Key)) || !string.IsNullOrEmpty(_envValues.GetValueOrDefault(d.Key)));

                <div class="ak-section">
                    <div class="ak-section__header">
                        <i class="bi @CategoryIcon(category)"></i>
                        <span class="ak-section__title">@category</span>
                        <span class="ak-section__count">@setCount / @allDefs.Count</span>
                    </div>

                    <div class="ak-list">
                        @foreach (ApiKeyDefinitionDto def in defs)
                        {
                            bool isEditing = _editingKey == def.Key;
                            string? dbVal  = _dbValues.GetValueOrDefault(def.Key);
                            string? envVal = _envValues.GetValueOrDefault(def.Key);
                            bool hasDb     = !string.IsNullOrEmpty(dbVal);
                            bool hasEnv    = !string.IsNullOrEmpty(envVal);
                            string statusMod = hasDb ? "ak-item--db" : hasEnv ? "ak-item--env" : "ak-item--missing";

                            <div class="ak-item @statusMod @(isEditing ? "ak-item--editing" : "")">
                                <div class="ak-item__stripe"></div>

                                <div class="ak-item__body">
                                    <div class="ak-item__top">
                                        <span class="ak-item__name">@def.DisplayName</span>
                                        @if (hasDb)
                                        {
                                            <span class="ak-badge ak-badge--db" title="@Loc.T("Overridden in database")">@Loc.T("from DB")</span>
                                        }
                                        else if (hasEnv)
                                        {
                                            <span class="ak-badge ak-badge--env" title="@Loc.T("Set via environment variable")">@Loc.T("from ENV")</span>
                                        }
                                        else
                                        {
                                            <span class="ak-badge ak-badge--missing">@Loc.T("Not set")</span>
                                        }
                                    </div>

                                    <div class="ak-item__key">@def.Key</div>

                                    @if (!string.IsNullOrEmpty(def.Description))
                                    {
                                        <div class="ak-item__desc">@def.Description</div>
                                    }

                                    @if (!isEditing)
                                    {
                                        @if (hasDb || hasEnv)
                                        {
                                            string display = hasDb ? dbVal! : envVal!;
                                            <div class="ak-item__value">
                                                <span class="ak-masked">@MaskValue(display, def.Sensitive)</span>
                                            </div>
                                        }
                                    }
                                    else
                                    {
                                        <div class="ak-edit">
                                            <input class="admin-form__input ak-edit__input"
                                                   type="@(def.Sensitive ? "password" : "text")"
                                                   placeholder="@(def.Sensitive ? Loc.T("Enter new value (leave blank to remove DB override)") : Loc.T("Enter value"))"
                                                   @bind="_editValue"
                                                   @bind:event="oninput" />
                                            @if (!string.IsNullOrEmpty(_editError))
                                            {
                                                <div class="ak-edit__error">@_editError</div>
                                            }
                                            <div class="ak-edit__actions">
                                                <button class="admin-btn admin-btn--primary admin-btn--sm"
                                                        @onclick="SaveEdit"
                                                        disabled="@_saving">
                                                    @if (_saving) { <i class="bi bi-arrow-clockwise admin-spin"></i> }
                                                    else          { <i class="bi bi-check-lg"></i> }
                                                    @Loc.T("Save")
                                                </button>
                                                <button class="admin-btn admin-btn--ghost admin-btn--sm"
                                                        @onclick="CancelEdit">
                                                    @Loc.T("Cancel")
                                                </button>
                                            </div>
                                        </div>
                                    }
                                </div>

                                @if (!isEditing)
                                {
                                    <div class="ak-item__actions">
                                        <button class="ak-icon-btn" title="@Loc.T("Edit")"
                                                @onclick="() => StartEdit(def.Key, dbVal ?? string.Empty)">
                                            <i class="bi bi-pencil"></i>
                                        </button>
                                        @if (hasDb)
                                        {
                                            <button class="ak-icon-btn ak-icon-btn--danger"
                                                    title="@Loc.T("Remove DB override, fall back to ENV")"
                                                    @onclick="() => RemoveOverride(def.Key)">
                                                <i class="bi bi-trash3"></i>
                                            </button>
                                        }
                                    </div>
                                }
                            </div>
                        }
                    </div>
                </div>
            }
        }
    </main>
</div>
