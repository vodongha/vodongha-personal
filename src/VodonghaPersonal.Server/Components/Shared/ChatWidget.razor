@rendermode InteractiveServer

@if (_state != ChatState.Closed)
{
    <div class="chat-panel">
        <div class="chat-header">
            <div class="chat-header__info">
                <div class="chat-header__avatar"><i class="bi bi-person-circle"></i></div>
                <div>
                    <div class="chat-header__name">@Lang.T("chat.title")</div>
                    <div class="chat-header__status">@Lang.T("chat.status")</div>
                </div>
            </div>
            <button type="button" class="chat-header__close" @onclick="Close" title="@Lang.T("chat.close")">
                <i class="bi bi-x-lg"></i>
            </button>
        </div>

        @if (_state == ChatState.Form)
        {
            <div class="chat-form">
                <div class="chat-form__title">@Lang.T("chat.form.title")</div>
                <div class="chat-form__subtitle">@Lang.T("chat.form.subtitle")</div>

                <div class="chat-form__group">
                    <label class="chat-form__label">@Lang.T("chat.form.name")</label>
                    <input class="chat-form__input @(_nameTouched && string.IsNullOrWhiteSpace(_name) ? "chat-form__input--error" : "")"
                           type="text" placeholder="@Lang.T("chat.form.name.placeholder")"
                           @bind="_name" @bind:event="oninput"
                           @onblur="() => _nameTouched = true" />
                    @if (_nameTouched && string.IsNullOrWhiteSpace(_name))
                    {
                        <span class="chat-form__error">@Lang.T("chat.form.name.required")</span>
                    }
                </div>
                <div class="chat-form__group">
                    <label class="chat-form__label">@Lang.T("chat.form.phone")</label>
                    <div class="chat-phone">
                        @* Dial picker — fully JS-driven to avoid Blazor re-render disrupting other inputs *@
                        <div class="chat-dial" id="chatDialPicker">
                            <button type="button" class="chat-dial__trigger"
                                    onclick="chatDial.toggle()"
                                    id="chatDialTrigger">
                                <span id="chatDialLabel">@SelectedCountry.Flag @SelectedCountry.Dial</span>
                                <i class="bi bi-chevron-down chat-dial__caret"></i>
                            </button>
                            <div class="chat-dial__dropdown" id="chatDialDropdown" style="display:none">
                                <div class="chat-dial__search-wrap">
                                    <i class="bi bi-search"></i>
                                    <input class="chat-dial__search" type="text"
                                           id="chatDialSearch"
                                           placeholder="Tìm quốc gia..."
                                           oninput="chatDial.filter(this.value)" />
                                </div>
                                <div class="chat-dial__list" id="chatDialList">
                                    @foreach (Country c in Countries)
                                    {
                                        <button type="button"
                                                class="chat-dial__item @(c.RegionCode == _selectedRegion ? "chat-dial__item--active" : "")"
                                                data-region="@c.RegionCode"
                                                data-dial="@c.Dial"
                                                data-name="@c.Name"
                                                onclick="chatDial.select(this)">
                                            <span class="chat-dial__flag">@c.Flag</span>
                                            <span class="chat-dial__name">@c.Name</span>
                                            <span class="chat-dial__code">@c.Dial</span>
                                        </button>
                                    }
                                </div>
                            </div>
                            <input type="hidden" id="chatDialRegion" value="@_selectedRegion"
                                   @onchange="e => _selectedRegion = e.Value?.ToString() ?? _selectedRegion" />
                        </div>
                        <input class="chat-phone__number @(_phoneTouched && !IsValidPhone(_phone) ? "chat-form__input--error" : "")"
                               type="tel" id="chatPhoneInput"
                               placeholder="@Lang.T("chat.form.phone.placeholder")"
                               oninput="chatDial.cleanPhone(this)"
                               @onchange="OnPhoneInput"
                               @onblur="OnPhoneBlur" />
                    </div>
                    @if (_phoneTouched && !IsValidPhone(_phone))
                    {
                        <span class="chat-form__error">@Lang.T("chat.form.phone.invalid")</span>
                    }
                </div>
                <div class="chat-form__group">
                    <label class="chat-form__label">@Lang.T("chat.form.email")</label>
                    <input class="chat-form__input @(_emailTouched && !IsValidEmail(_email) ? "chat-form__input--error" : "")"
                           type="email" placeholder="email@example.com"
                           @bind="_email" @bind:event="oninput"
                           @onblur="() => _emailTouched = true" />
                    @if (_emailTouched && !IsValidEmail(_email))
                    {
                        <span class="chat-form__error">@Lang.T("chat.form.email.invalid")</span>
                    }
                </div>

                <button type="button" class="chat-form__submit" @onclick="StartChat"
                        disabled="@(!CanStartChat || _loading)">
                    <span>@Lang.T("chat.form.start") <i class="bi bi-arrow-right"></i></span>
                </button>
            </div>
        }
        else if (_state == ChatState.Chat)
        {
            <div class="chat-messages" id="chatMessages">
                @for (int i = 0; i < _messages.Count; i++)
                {
                    ChatMessageDto msg = _messages[i];
                    bool isUnread = !msg.IsFromUser && _unreadDividerIndex >= 0 && i >= _unreadDividerIndex;

                    @* Date divider — show when this message is on a different day than the previous one *@
                    DateTime msgDay = Tz.ToUserTime(msg.SentAt).Date;
                    bool showDate = i == 0 || Tz.ToUserTime(_messages[i - 1].SentAt).Date != msgDay;
                    @if (showDate)
                    {
                        DateTime today = Tz.ToUserTime(DateTime.UtcNow).Date;
                        string dateLabel = msgDay == today ? Lang.T("chat.today")
                            : msgDay == today.AddDays(-1) ? Lang.T("chat.yesterday")
                            : msgDay.ToString("dd/MM/yyyy");
                        <div class="chat-date-divider"><span>@dateLabel</span></div>
                    }

                    @if (i == _unreadDividerIndex)
                    {
                        <div class="chat-unread-divider">
                            <span>@Lang.T("chat.new")</span>
                        </div>
                    }

                    <div class="chat-msg @(msg.IsFromUser ? "chat-msg--user" : "chat-msg--admin") @(isUnread ? "chat-msg--unread" : "") @(msg.Id == 0 ? "chat-msg--pending" : "")">
                        <div class="chat-msg__bubble">@msg.Content</div>
                        <div class="chat-msg__time">
                            @Tz.ToUserTime(msg.SentAt).ToString("HH:mm")
                            @if (msg.IsFromUser)
                            {
                                if (_adminReadUpToId > 0 && msg.Id <= _adminReadUpToId)
                                {
                                    <i class="bi bi-check-all chat-msg__ticks chat-msg__ticks--read" title="@Lang.T("chat.read")"></i>
                                }
                                else
                                {
                                    <i class="bi bi-check chat-msg__ticks" title="@Lang.T("chat.sent")"></i>
                                }
                            }
                        </div>
                    </div>
                }

                @if (_messages.Count == 0)
                {
                    <div style="text-align:center; color:#6b7280; font-size:0.8rem; margin-top:1rem;">
                        @Lang.T("chat.empty")
                    </div>
                }

                @if (_otherIsTyping)
                {
                    <div class="chat-msg chat-msg--admin">
                        <div class="chat-typing">
                            <span></span><span></span><span></span>
                        </div>
                    </div>
                }
            </div>

            @if (_pushDenied)
            {
                <div class="chat-push-hint">
                    <i class="bi bi-bell-slash"></i>
                    <span>@Lang.T("chat.push.denied")</span>
                    <a href="@_pushHelpUrl" target="_blank" rel="noopener" class="chat-push-hint__link">
                        @Lang.T("chat.push.howto")
                    </a>
                    <button type="button" class="chat-push-hint__close" @onclick="() => _pushDenied = false" title="Đóng">
                        <i class="bi bi-x"></i>
                    </button>
                </div>
            }

            <div class="chat-input">
                <textarea class="chat-input__field" id="chatMsgInput" rows="1"
                          placeholder="@Lang.T("chat.placeholder")"
                          oninput="chatUtils.onMsgInput(this)"
                          onkeydown="chatUtils.onMsgKeyDown(event)"></textarea>
                <button type="button" class="chat-input__send" id="chatSendBtn"
                        @onclick="SendMessage" disabled>
                    <i class="bi bi-send-fill"></i>
                </button>
            </div>
        }
    </div>
}

<button type="button" class="chat-fab @(_state != ChatState.Closed ? "chat-fab--panel-open" : "")" @onclick="ToggleOpen"
        title="@Lang.T("chat.fab.title")"
        aria-label="@(_state == ChatState.Closed ? Lang.T("chat.fab.open") : Lang.T("chat.fab.close"))"
        aria-expanded="@(_state != ChatState.Closed ? "true" : "false")">
    @if (_state == ChatState.Closed)
    {
        <i class="bi bi-chat-dots-fill"></i>
        @if (_unreadCount > 0)
        {
            <span class="chat-fab__badge">@(_unreadCount > 9 ? "9+" : _unreadCount.ToString())</span>
        }
    }
    else
    {
        <i class="bi bi-chevron-down"></i>
    }
</button>
